  runtime:
    process:
      name: emerge
      cmd: node
      args:
        - '{{root}}/emerge/emerge/server.js'
      cwd: emerge/emerge
      phase: 3
      optional: true
      healthUrl: http://127.0.0.1:4900/health
      compartment: nexus-self-emerge
      boundary:
        mode: enforce
        allow:
          - '{{root}}/emerge/'
          - '{{root}}/node_modules/'
