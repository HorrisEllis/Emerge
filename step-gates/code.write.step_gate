envelope: 1
uuid: nexus-step-gate-code-write
type: step_gate
id: code.write
context: lib/step-gates — the gate each extracted file passes before it is proposed, staged or written (0.39.282 N21).
intent: No file is ever written empty, and no file of a language we can check is written unparseable.
summary: An empty fenced block became a 1-byte file proposal; a half-streamed block could be written as broken code.
system: nexus
tags: [step_gate, build]
source: docs/2026-09-29-nex-node-store-phasemap.spec#N21
payload:
  step: code.write
  on_block: drop
  checks:
    - id: file-non-empty
      kind: non_empty
      min_chars: 1
    - id: file-parses
      kind: parses
      # '*' = every language lib/checks/ck-248-toolchain.js knows (its own parser, when installed); a language it does not know,
      # or whose tool is not installed, passes this check (it is not proof, just not checkable here: the evidence says so)
      languages: ['*']
    # 0.60.66 SF3 — James: "need to inject a framework for generating a .spec file. then need to listen for it to collect it."
    # A .spec whose top key is spec: (the compiler's format, written from the spec-framework block) must be readable by it.
    - id: spec-compiler-format
      kind: spec_format
    # 0.60.104 — James's screenshot: an agent's file said '// Placeholder implementation' and passed its brick. A file an agent
    # writes that calls itself a placeholder or stub in a comment is refused (a person's file is never judged by this).
    # Matched case-insensitively inside comments only; extend the list here, not in code.
    - id: not-a-placeholder
      kind: no_placeholder
      phrases:
        - "placeholder implementation"
        - "placeholder for the"
        - "placeholder: "
        - "stub implementation"
        - "stub for now"
        - "todo: implement"
        - "todo implement"
        - "implement me"
        - "implement this"
        - "not implemented"
        - "not yet implemented"
        - "your code here"
        - "add your code"
        - "rest of the implementation"
        - "existing code here"
        - "logic goes here"
        - "implementation goes here"
