nfn rt_print(list) \{\n  let b = rt_sb_new()\n  let n = mem_get(list + 8)\n  let items = mem_get(list + 24)\n  var i = 0\n  while i < n \{\n    if i > 0 \{ rt_sb_byte(b, 32) \}\n    rt_show_into(b, mem_get(items + i * 8), 0)\n    i = i + 1\n  \}\n  rt_sb_byte(b, 10)\n  rt_write(1, mem_get(b), mem_get(b + 8))\n  return NULL\n\}\nfn rt_concat(a, b) \{\n  let sb = rt_sb_new()\n  rt_sb_str(sb, a)\n  rt_sb_str(sb, b)\n  return rt_sb_done(sb)\n\}\n\n// ── lists ────────────────────────────────────────────────────────────────────\nfn rt_list_new(cap) \{\n  var c = cap\n  if c < 4 \{ c = 4 \}\n  let l = rt_alloc(32)\n  mem_set(l, K_LIST)\n  mem_set(l + 8, 0)\n  mem_set(l + 16, c)\n  mem_set(l + 24, rt_alloc(c * 8))\n  return l\n\}\nfn rt_list_push(l, v) \{\n  let n = mem_get(l + 8)\n  let cap = mem_get(l + 16)\n  if n == cap \{\n    let items = rt_alloc(cap * 16)\n    mem_copy(items, mem_get(l + 24), n * 8)\n    mem_set(l + 24, items)\n    mem_set(l + 16, cap * 2)\n  \}\n  mem_set(mem_get(l + 24) + n * 8, v)\n  mem_set(l + 8, n + 1)\n  return l\n\}\nfn rt_list_get(l, i) \{ return mem_get(mem_get(l + 24) + i * 8) \}\nfn rt_list_len_t(l) \{ return rt_mknum(mem_get(l + 8)) \}\nfn rt_list_at_t(l, i) \{ return rt_list_get(l, i >> 3) \}\n\n// ── maps ─────────────────────────────────────────────────────────────────────\nfn rt_map_new() \{\n  let m = rt_alloc(56)\n  mem_set(m, K_MAP)\n  mem_set(m + 8, 0)\n  mem_set(m + 16, 8)\n  mem_set(m + 24, rt_alloc(64))\n  mem_set(m + 32, rt_alloc(64))\n  mem_set(m + 40, rt_alloc(128))\n  mem_set(m + 48, 16)\n  return m\n\}\nfn rt_hash(s) \{\n  var h = -3750763034362895579i\n  let n = mem_get(s + 8)\n  var i = 0\n  while i < n \{\n    h = (h ^ mem_get8(s + 24 + i)) * 1099511628211\n    i = i + 1\n  \}\n  return h\n\}\nfn rt_map_find(m, k) \{\n  let idx = mem_get(m + 40)\n  let mask = mem_get(m + 48) - 1\n  let keys = mem_get(m + 24)\n  var i = rt_hash(k) & mask\n  while 1 \{\n    let e = mem_get(idx + i * 8)\n    if e == 0 \{ return -1 \}\n    if rt_str_eq(mem_get(keys + (e - 1) * 8), k) \{ return e - 1 \}\n    i = (i + 1) & mask\n  \}\n  return -1\n\}\nfn rt_map_index_insert(m, k, e) \{\n  let idx = mem_get(m + 40)\n  let mask = mem_get(m + 48) - 1\n  var i = rt_hash(k) & mask\n  while mem_get(idx + i * 8) != 0 \{ i = (i + 1) & mask \}\n  mem_set(idx + i * 8, e + 1)\n  return 0\n\}\n// a key that JavaScript treats as an array index: \"0\" or a digit string without a leading 0, below 2^32 - 1; else -1\nfn rt_key_index(k) \{\n  let n = mem_get(k + 8)\n  if n == 0 or n > 10 \{ return -1 \}\n  if n > 1 and mem_get8(k + 24) == 48 \{ return -1 \}\n  var v = 0\n  var i = 0\n  while i < n \{\n    let c = mem_get8(k + 24 + i)\n    if c < 48 or c > 57 \{ return -1 \}\n    v = v * 10 + (c - 48)\n    i = i + 1\n  \}\n  if v > 4294967294 \{ return -1 \}\n  return v\n\}\nfn rt_map_set(m, k, v) \{\n  if rt_kind(k) != K_STR \{ rt_fail2(\"a map key must be a string, got \", rt_type_name(k)) \}\n  let e = rt_map_find(m, k)\n  if e >= 0 \{\n    mem_set(mem_get(m + 32) + e * 8, v)\n    return m\n  \}\n  let n = mem_get(m + 8)\n  let cap = mem_get(m + 16)\n  if n == cap \{\n    let nk = rt_alloc(cap * 16)\n    let nv = rt_alloc(cap * 16)\n    mem_copy(nk, mem_get(m + 24), n * 8)\n    mem_copy(nv, mem_get(m + 32), n * 8)\n    mem_set(m + 24, nk)\n    mem_set(m + 32, nv)\n    mem_set(m + 16, cap * 2)\n  \}\n  // the interpreter's maps are JavaScript objects: keys that are array indices (\"0\", \"17\") come first, in numeric\n  // order, then the other keys in insertion order\n  let ki = rt_key_index(k)\n  var at = n\n  if ki >= 0 \{\n    at = 0\n    while at < n \{\n      let ok = rt_key_index(mem_get(mem_get(m + 24) + at * 8))\n      if ok < 0 or ok > ki \{ break \}\n      at = at + 1\n    \}\n  \}\n  var j = n\n  while j > at \{\n    mem_set(mem_get(m + 24) + j * 8, mem_get(mem_get(m + 24) + (j - 1) * 8))\n    mem_set(mem_get(m + 32) + j * 8, mem_get(mem_get(m + 32) + (j - 1) * 8))\n    j = j - 1\n  \}\n  mem_set(mem_get(m + 24) + at * 8, k)\n  mem_set(mem_get(m + 32) + at * 8, v)\n  mem_set(m + 8, n + 1)\n  if at < n \{\n    // entries moved: rebuild the hash index\n    let icap = mem_get(m + 48)\n    var c = 0\n    while c < icap \{\n      mem_set(mem_get(m + 40) + c * 8, 0)\n      c = c + 1\n    \}\n    var i = 0\n    while i <= n \{\n      rt_map_index_insert(m, mem_get(mem_get(m + 24) + i * 8), i)\n      i = i + 1\n    \}\n  \}\n  if at < n and (n + 1) * 2 <= mem_get(m + 48) \{ return m \}\n  if (n + 1) * 2 > mem_get(m + 48) \{\n    let icap = mem_get(m + 48) * 2\n    mem_set(m + 40, rt_alloc(icap * 8))\n    mem_set(m + 48, icap)\n    var i = 0\n    while i <= n \{\n      rt_map_index_insert(m, mem_get(mem_get(m + 24) + i * 8), i)\n      i = i + 1\n    \}\n  \} else \{\n    rt_map_index_insert(m, k, n)\n  \}\n  return m\n\}\nfn rt_map_get(m, k) \{\n  if rt_kind(k) != K_STR \{ return NULL \}\n  let e = rt_map_find(m, k)\n  if e < 0 \{ return NULL \}\n  return mem_get(mem_get(m + 32) + e * 8)\n\}\n\n// ── bytes ────────────────────────────────────────────────────────────────────\nfn rt_bytes_new(n) \{\n  let b = rt_alloc(16 + n)\n  mem_set(b, K_BYTES)\n  mem_set(b + 8, n)\n  return b\n\}\nfn rt_bytes_flatten(sb, v) \{\n  let t = v & 7\n  if t == 1 or t == 3 or rt_kind(v) == K_INT \{\n    var x = 0\n    if t == 1 \{ x = v >> 3 \} else \{ x = rt_intval(v) \}\n    if x < 0 or x > 255 \{ rt_fail(\"bytes: every number must be 0..255\") \}\n    return rt_sb_byte(sb, x)\n  \}\n  let k = rt_kind(v)\n  if k == K_BYTES \{ return rt_sb_add(sb, v + 16, mem_get(v + 8)) \}\n  if k == K_STR \{ return rt_sb_add(sb, v + 24, mem_get(v + 8)) \}\n  if k == K_LIST \{\n    let n = mem_get(v + 8)\n    var i = 0\n    while i < n \{\n      rt_bytes_flatten(sb, rt_list_get(v, i))\n      i = i + 1\n    \}\n    return 0\n  \}\n  return rt_fail2(\"bytes: cannot take bytes of a \", rt_type_name(v))\n\}\n\n// ── numbers ──────────────────────────────────────────────────────────────────\nfn rt_num_or_int_error(op, a, b) \{\n  let sb = rt_sb_new()\n  rt_sb_str(sb, op)\n  rt_sb_str(sb, \" needs two nums or two ints, got \")\n  rt_sb_str(sb, rt_type_name(a))\n  rt_sb_str(sb, \" and \")\n  rt_sb_str(sb, rt_type_name(b))\n  return rt_die_lit(rt_sb_done(sb))\n\}\nfn rt_int_result(x) \{ return rt_mkint(x) \}\nfn rt_add(a, b) \{\n  if (a & 7) == 1 and (b & 7) == 1 \{ return rt_mknum((a >> 3) + (b >> 3)) \}\n  if rt_is_int(a) and rt_is_int(b) \{\n    let x = rt_intval(a)\n    let y = rt_intval(b)\n    if add_ovf(x, y) \{ rt_ovf(\"+\") \}\n    return rt_mkint(x + y)\n  \}\n  if (rt_is_int(a) and rt_isnum(b)) or (rt_isnum(a) and rt_is_int(b)) \{ rt_mixed(\"+\", a, b) \}\n  if rt_fl2(a, b) \{ return rt_f2(0, a, b) \}\n  let ka = rt_kind(a)\n  let kb = rt_kind(b)\n  if ka == K_STR \{ return rt_concat(a, rt_tostr(b)) \}\n  if ka == K_BYTES and kb == K_BYTES \{\n    let na = mem_get(a + 8)\n    let nb = mem_get(b + 8)\n    let r = rt_bytes_new(na + nb)\n    mem_copy(r + 16, a + 16, na)\n    mem_copy(r + 16 + na, b + 16, nb)\n    return r\n  \}\n  if ka == K_MAP and kb == K_MAP \{\n    let m = rt_map_new()\n    var i = 0\n    while i < mem_get(a + 8) \{\n      rt_map_set(m, mem_get(mem_get(a + 24) + i * 8), mem_get(mem_get(a + 32) + i * 8))\n      i = i + 1\n    \}\n    i = 0\n    while i < mem_get(b + 8) \{\n      rt_map_set(m, mem_get(mem_get(b + 24) + i * 8), mem_get(mem_get(b + 32) + i * 8))\n      i = i + 1\n    \}\n    return m\n  \}\n  if ka == K_LIST and kb == K_LIST \{\n    let na = mem_get(a + 8)\n    let nb = mem_get(b + 8)\n    let l = rt_list_new(na + nb)\n    var i = 0\n    while i < na \{\n      rt_list_push(l, rt_list_get(a, i))\n      i = i + 1\n    \}\n    i = 0\n    while i < nb \{\n      rt_list_push(l, rt_list_get(b, i))\n      i = i + 1\n    \}\n    return l\n  \}\n  return rt_fail4(\"+ cannot combine \", rt_type_name(a), \" and \", rt_type_name(b))\n\}\nfn rt_sub(a, b) \{\n  if (a & 7) == 1 and (b & 7) == 1 \{ return rt_mknum((a >> 3) - (b >> 3)) \}\n  if rt_is_int(a) and rt_is_int(b) \{\n    let x = rt_intval(a)\n    let y = rt_intval(b)\n    if sub_ovf(x, y) \{ rt_ovf(\"-\") \}\n    return rt_mkint(x - y)\n  \}\n  if rt_fl2(a, b) \{ return rt_f2(1, a, b) \}\n  return rt_num_or_int_error(\"-\", a, b)\n\}\nfn rt_mul(a, b) \{\n  if (a & 7) == 1 and (b & 7) == 1 \{\n    let x = a >> 3\n    let y = b >> 3\n    if mul_ovf(x, y) \{ return rt_fnum(f_mul(f_of_int(x), f_of_int(y))) \}\n    return rt_mknum(x * y)\n  \}\n  if rt_is_int(a) and rt_is_int(b) \{\n    let x = rt_intval(a)\n    let y = rt_intval(b)\n    if mul_ovf(x, y) \{ rt_ovf(\"*\") \}\n    return rt_mkint(x * y)\n  \}\n  if rt_fl2(a, b) \{ return rt_f2(2, a, b) \}\n  return rt_num_or_int_error(\"*\", a, b)\n\}\nfn rt_num_pow(a, b) \{\n  let x = a >> 3\n  var y = b >> 3\n  if y < 0 \{ return rt_unsupported(\"** with a fractional num\") \}\n  var r = 1\n  while y > 0 \{\n    if mul_ovf(r, x) \{ rt_unsupported(\"a num beyond 2^53\") \}\n    r = r * x\n    y = y - 1\n  \}\n  return rt_mknum(r)\n\}\nfn rt_div(a, b) \{\n  if (a & 7) == 1 and (b & 7) == 1 \{\n    let x = a >> 3\n    let y = b >> 3\n    if y == 0 \{ rt_fail(\"division by zero\") \}\n    if x % y != 0 \{ return rt_fnum(f_div(f_of_int(x), f_of_int(y))) \}\n    return rt_mknum(x / y)\n  \}\n  if rt_is_int(a) and rt_is_int(b) \{ rt_fail(\"int / int is refused: use idiv(a, b)\") \}\n  if rt_fl2(a, b) \{\n    if b == 1 \{ rt_fail(\"division by zero\") \}\n    return rt_f2(3, a, b)\n  \}\n  return rt_num_or_int_error(\"/\", a, b)\n\}\nfn rt_floor_div(x, y) \{\n  var q = x / y\n  if (x % y != 0) and ((x < 0) != (y < 0)) \{ q = q - 1 \}\n  return q\n\}\nfn rt_floor_mod(x, y) \{\n  if y == -1 \{ return 0 \}\n  var r = x % y\n  if r != 0 and ((r < 0) != (y < 0)) \{ r = r + y \}\n  return r\n\}\nfn rt_mod(a, b) \{\n  if (a & 7) == 1 and (b & 7) == 1 \{\n    let y = b >> 3\n    if y == 0 \{ rt_fail(\"modulo by zero\") \}\n    return rt_mknum(rt_floor_mod(a >> 3, y))\n  \}\n  if rt_is_int(a) and rt_is_int(b) \{\n    let y = rt_intval(b)\n    if y == 0 \{ rt_fail(\"modulo by zero\") \}\n    return rt_mkint(rt_floor_mod(rt_intval(a), y))\n  \}\n  if rt_fl2(a, b) \{\n    // the interpreter's ((a % b) + b) % b, with % as JavaScript's (fmod)\n    if b == 1 \{ rt_fail(\"modulo by zero\") \}\n    let y = rt_fbits(b)\n    return rt_fnum(rt_fmod(f_add(rt_fmod(rt_fbits(a), y), y), y))\n  \}\n  return rt_num_or_int_error(\"%\", a, b)\n\}\nfn rt_idiv(a, b) \{\n  if rt_is_int(a) and rt_is_int(b) \{\n    let x = rt_intval(a)\n    let y = rt_intval(b)\n    if y == 0 \{ rt_fail(\"division by zero\") \}\n    if y == -1 \{\n      if sub_ovf(0, x) \{ rt_ovf(\"idiv\") \}\n      return rt_mkint(0 - x)\n    \}\n    return rt_mkint(rt_floor_div(x, y))\n  \}\n  if (a & 7) == 1 and (b & 7) == 1 \{\n    let y = b >> 3\n    if y == 0 \{ rt_fail(\"division by zero\") \}\n    return rt_mknum(rt_floor_div(a >> 3, y))\n  \}\n  if rt_fl2(a, b) \{\n    // nums must be whole (a double beyond 2^53 is): Math.floor(a / b), as the interpreter\n    let x = rt_fbits(a)\n    let y = rt_fbits(b)\n    if not rt_f_whole(x) or not rt_f_whole(y) \{\n      let sb = rt_sb_new()\n      rt_sb_str(sb, \"idiv needs two ints, got num \")\n      rt_show_into(sb, a, 1)\n      rt_sb_str(sb, \" and num \")\n      rt_show_into(sb, b, 1)\n      return rt_die_lit(rt_sb_done(sb))\n    \}\n    if b == 1 \{ rt_fail(\"division by zero\") \}\n    return rt_fnum(rt_f_floor(f_div(x, y)))\n  \}\n  return rt_num_or_int_error(\"idiv\", a, b)\n\}\nfn rt_neg(a) \{\n  if (a & 7) == 1 \{ return rt_mknum(0 - (a >> 3)) \}\n  if rt_is_flt(a) \{ return rt_fbox(mem_get(a + 8) ^ rt_sign_bit()) \}\n  if rt_is_int(a) \{\n    let x = rt_intval(a)\n    if sub_ovf(0, x) \{ rt_ovf(\"unary -\") \}\n    return rt_mkint(0 - x)\n  \}\n  return rt_fail2(\"unary - needs a num or an int, got \", rt_type_name(a))\n\}\nfn rt_not(a) \{\n  if rt_truth(a, \"not\") \{ return FALSE \}\n  return TRUE\n\}\n// a condition must be a bool: \"if needs a bool, got num 1\", as the interpreter says\nfn rt_truth(a, what) \{\n  if a == TRUE \{ return 1 \}\n  if a == FALSE \{ return 0 \}\n  let sb = rt_sb_new()\n  rt_sb_str(sb, what)\n  rt_sb_str(sb, \" needs a bool, got \")\n  rt_sb_str(sb, rt_type_name(a))\n  rt_sb_byte(sb, 32)\n  rt_show_into(sb, a, 1)\n  return rt_die_lit(rt_sb_done(sb))\n\}\n// Bit operations, as the interpreter does them. On nums: 32-bit words — a num in [-2^31, 2^32) taken as its unsigned\n// 32-bit pattern, every result an unsigned word in [0, 2^32), >> logical, shift counts 0..31. On ints: the 64-bit two's\n// complement pattern — & | ^ need two ints, << wraps, >> is arithmetic, shift counts 0..63 given as a num or an int.\nfn rt_word(v, op) \{\n  if rt_is_flt(v) \{ rt_fail3(op, \" works on 32-bit words: an int in [-2^31, 2^32), got \", rt_show(v, 1)) \}\n  if (v & 7) != 1 \{ rt_num_or_int_error(op, v, v) \}\n  let x = v >> 3\n  if x < -2147483648 or x > 4294967295 \{ rt_fail3(op, \" works on 32-bit words: an int in [-2^31, 2^32), got \", rt_show(v, 1)) \}\n  return x & 4294967295\n\}\nfn rt_count(n, op, most) \{\n  var c = -1\n  if (n & 7) == 1 \{ c = n >> 3 \} else if rt_is_int(n) and most == 63 \{ c = rt_intval(n) \}\n  if c < 0 or c > most \{\n    if most == 63 \{ rt_fail3(op, \" on an int needs a shift count in 0..63, got \", rt_show(n, 1)) \}\n    rt_fail3(op, \" needs a shift count in 0..31, got \", rt_show(n, 1))\n  \}\n  return c\n\}\nfn rt_mixed(op, a, b) \{\n  let sb = rt_sb_new()\n  rt_sb_str(sb, op)\n  rt_sb_str(sb, \" does not mix int and num (got \")\n  rt_sb_str(sb, rt_type_name(a))\n  rt_sb_str(sb, \" and \")\n  rt_sb_str(sb, rt_type_name(b))\n  rt_sb_str(sb, \"): convert explicitly with int(x) or num(x)\")\n  return rt_die_lit(rt_sb_done(sb))\n\}\nfn rt_bitop(op, a, b) \{\n  let name = rt_bitname(op)\n  if op <= 3 \{\n    if rt_is_int(a) or rt_is_int(b) \{\n      if not (rt_is_int(a) and rt_is_int(b)) \{ rt_mixed(name, a, b) \}\n      let x = rt_intval(a)\n      let y = rt_intval(b)\n      if op == 1 \{ return rt_mkint(x & y) \}\n      if op == 2 \{ return rt_mkint(x | y) \}\n      return rt_mkint(x ^ y)\n    \}\n    let wa = rt_word(a, name)\n    let wb = rt_word(b, name)\n    if op == 1 \{ return rt_mknum(wa & wb) \}\n    if op == 2 \{ return rt_mknum(wa | wb) \}\n    return rt_mknum(wa ^ wb)\n  \}\n  if rt_is_int(a) \{\n    let c = rt_count(b, name, 63)\n    let x = rt_intval(a)\n    if op == 4 \{ return rt_mkint(x << c) \}\n    if op == 5 \{ return rt_mkint(x >> c) \}\n    return rt_mkint(shr_u(x, c))\n  \}\n  let w = rt_word(a, name)\n  let c = rt_count(b, name, 31)\n  if op == 4 \{ return rt_mknum((w << c) & 4294967295) \}\n  return rt_mknum(shr_u(w, c))\n\}\nfn rt_bitname(op) \{\n  if op == 1 \{ return \"&\" \}\n  if op == 2 \{ return \"|\" \}\n  if op == 3 \{ return \"^\" \}\n  if op == 4 \{ return \"<<\" \}\n  if op == 5 \{ return \">>\" \}\n  return \"shr_u\"\n\}\nfn rt_band(a, b) \{ return rt_bitop(1, a, b) \}\nfn rt_bor(a, b) \{ return rt_bitop(2, a, b) \}\nfn rt_bxor(a, b) \{ return rt_bitop(3, a, b) \}\nfn rt_shl(a, b) \{ return rt_bitop(4, a, b) \}\nfn rt_sar(a, b) \{ return rt_bitop(5, a, b) \}\nfn rt_shr_u(a, b) \{\n  if not rt_is_int(a) \{ rt_fail2(\"shr_u needs an int, got \", rt_type_name(a)) \}\n  return rt_bitop(6, a, b)\n\}\nfn rt_bnot(a) \{\n  if rt_is_int(a) \{ return rt_mkint(-1 - rt_intval(a)) \}\n  return rt_mknum((-1 - rt_word(a, \"~\")) & 4294967295)\n\}\n\n// ── equality and order ───────────────────────────────────────────────────────\nfn rt_eq_raw(a, b) \{\n  if a == b \{ return 1 \}\n  let ta = a & 7\n  let tb = b & 7\n  if ta != 0 or tb != 0 \{\n    // a boxed int equals a small int of the same value only if both are ints (it never does: small ones are never boxed)\n    return 0\n  \}\n  if a == 0 or b == 0 \{ return 0 \}\n  let k = mem_get(a)\n  if k != mem_get(b) \{ return 0 \}\n  if k == K_STR \{ return rt_str_eq(a, b) \}\n  if k == K_INT \{ return mem_get(a + 8) == mem_get(b + 8) \}\n  if k == K_FLT \{ return f_eq(mem_get(a + 8), mem_get(b + 8)) \}\n  if k == K_BYTES \{\n    let n = mem_get(a + 8)\n    if n != mem_get(b + 8) \{ return 0 \}\n    var i = 0\n    while i < n \{\n      if mem_get8(a + 16 + i) != mem_get8(b + 16 + i) \{ return 0 \}\n      i = i + 1\n    \}\n    return 1\n  \}\n  if k == K_LIST \{\n    let n = mem_get(a + 8)\n    if n != mem_get(b + 8) \{ return 0 \}\n    var i = 0\n    while i < n \{\n      if not rt_eq_raw(rt_list_get(a, i), rt_list_get(b, i)) \{ return 0 \}\n      i = i + 1\n    \}\n    return 1\n  \}\n  if k == K_MAP \{\n    let n = mem_get(a + 8)\n    if n != mem_get(b + 8) \{ return 0 \}\n    var i = 0\n    while i < n \{\n      let key = mem_get(mem_get(a + 24) + i * 8)\n      let e = rt_map_find(b, key)\n      if e < 0 \{ return 0 \}\n      if not rt_eq_raw(mem_get(mem_get(a + 32) + i * 8), mem_get(mem_get(b + 32) + e * 8)) \{ return 0 \}\n      i = i + 1\n    \}\n    return 1\n  \}\n  return 0\n\}\nfn rt_eq(a, b) \{ return rt_bool(rt_eq_raw(a, b)) \}\nfn rt_ne(a, b) \{ return rt_bool(not rt_eq_raw(a, b)) \}\nfn rt_order(op, a, b) \{\n  if (a & 7) == 1 and (b & 7) == 1 \{ return a - b \}\n  if rt_fl2(a, b) \{\n    let x = rt_fbits(a)\n    let y = rt_fbits(b)\n    if f_lt(x, y) \{ return -1 \}\n    if f_lt(y, x) \{ return 1 \}\n    return 0\n  \}\n  if rt_is_int(a) and rt_is_int(b) \{\n    let x = rt_intval(a)\n    let y = rt_intval(b)\n    if x < y \{ return -1 \}\n    if x > y \{ return 1 \}\n    return 0\n  \}\n  if rt_kind(a) == K_STR and rt_kind(b) == K_STR \{ return rt_str_cmp(a, b) \}\n  let sb = rt_sb_new()\n  rt_sb_str(sb, op)\n  rt_sb_str(sb, \" compares two nums, two ints or two strings, got \")\n  rt_sb_str(sb, rt_type_name(a))\n  rt_sb_str(sb, \" and \")\n  rt_sb_str(sb, rt_type_name(b))\n  return rt_die_lit(rt_sb_done(sb))\n\}\nfn rt_lt(a, b) \{\n  if rt_fl2(a, b) \{ return rt_bool(f_lt(rt_fbits(a), rt_fbits(b))) \}\n  return rt_bool(rt_order(\"<\", a, b) < 0)\n\}\nfn rt_le(a, b) \{\n  if rt_fl2(a, b) \{ return rt_bool(f_le(rt_fbits(a), rt_fbits(b))) \}\n  return rt_bool(rt_order(\"<=\", a, b) <= 0)\n\}\nfn rt_gt(a, b) \{\n  if rt_fl2(a, b) \{ return rt_bool(f_lt(rt_fbits(b), rt_fbits(a))) \}\n  return rt_bool(rt_order(\">\", a, b) > 0)\n\}\nfn rt_ge(a, b) \{\n  if rt_fl2(a, b) \{ return rt_bool(f_le(rt_fbits(b), rt_fbits(a))) \}\n  return rt_bool(rt_order(\">=\", a, b) >= 0)\n\}\nfn rt_contains(a, b) \{\n  let k = rt_kind(a)\n  if k == K_LIST \{\n    let n = mem_get(a + 8)\n    var i = 0\n    while i < n \{\n      if rt_eq_raw(rt_list_get(a, i), b) \{ return TRUE \}\n      i = i + 1\n    \}\n    return FALSE\n  \}\n  if k == K_STR and rt_kind(b) == K_STR \{ return rt_bool(rt_str_find(a, b) >= 0) \}\n  if k == K_MAP \{ return rt_bool(rt_kind(b) == K_STR and rt_map_find(a, b) >= 0) \}\n  return rt_fail2(\"contains needs a list, string or map, got \", rt_type_name(a))\n\}\nfn rt_starts_with(a, b) \{\n  if rt_kind(a) != K_STR or rt_kind(b) != K_STR \{ rt_fail(\"starts_with needs two strings\") \}\n  let m = mem_get(b + 8)\n  if m > mem_get(a + 8) \{ return FALSE \}\n  var i = 0\n  while i < m \{\n    if mem_get8(a + 24 + i) != mem_get8(b + 24 + i) \{ return FALSE \}\n    i = i + 1\n  \}\n  return TRUE\n\}\nfn rt_ends_with(a, b) \{\n  if rt_kind(a) != K_STR or rt_kind(b) != K_STR \{ rt_fail(\"ends_with needs two strings\") \}\n  let n = mem_get(a + 8)\n  let m = mem_get(b + 8)\n  if m > n \{ return FALSE \}\n  var i = 0\n  while i < m \{\n    if mem_get8(a + 24 + n - m + i) != mem_get8(b + 24 + i) \{ return FALSE \}\n    i = i + 1\n  \}\n  return TRUE\n\}\n\n// ── indexing ─────────────────────────────────────────────────────────────────\nfn rt_index_num(i) \{ return rt_index_of(i, 0, 0) \}\n// what: \"list\", \"string\" or \"bytes\" when indexing one (the interpreter's messages), 0 for get and slice\nfn rt_index_of(i, what, n) \{\n  if (i & 7) == 1 \{ return i >> 3 \}\n  if rt_is_int(i) \{ return rt_intval(i) \}\n  if rt_is_flt(i) and what != 0 \{\n    if not rt_f_whole(mem_get(i + 8)) \{ rt_fail3(what, \" index must be an int, got \", rt_type_name(i)) \}\n    // a whole double beyond 2^53 is never inside a list\n    let sb = rt_sb_new()\n    rt_sb_str(sb, \"index \")\n    rt_show_into(sb, i, 0)\n    rt_sb_str(sb, \" is out of range for a \")\n    rt_sb_str(sb, what)\n    rt_sb_str(sb, \" of \")\n    rt_sb_dec(sb, n)\n    return rt_die_lit(rt_sb_done(sb))\n  \}\n  return rt_fail2(\"an index must be a num or an int, got \", rt_type_name(i))\n\}\nfn rt_range_error(i, what, n) \{\n  let sb = rt_sb_new()\n  rt_sb_str(sb, \"index \")\n  rt_sb_dec(sb, i)\n  rt_sb_str(sb, \" is out of range for a \")\n  rt_sb_str(sb, what)\n  rt_sb_str(sb, \" of \")\n  rt_sb_dec(sb, n)\n  return rt_die_lit(rt_sb_done(sb))\n\}\nfn rt_index(o, i) \{\n  let k = rt_kind(o)\n  if k == K_MAP \{ return rt_map_get(o, i) \}\n  if k == K_LIST \{\n    let n = mem_get(o + 8)\n    var x = rt_index_of(i, \"list\", n)\n    let orig = x\n    if x < 0 \{ x = x + n \}\n    if x < 0 or x >= n \{ rt_range_error(orig, \"list\", n) \}\n    return rt_list_get(o, x)\n  \}\n  if k == K_STR \{\n    let n = mem_get(o + 16)\n    var x = rt_index_of(i, \"string\", n)\n    let orig = x\n    if x < 0 \{ x = x + n \}\n    if x < 0 or x >= n \{ rt_range_error(orig, \"string\", n) \}\n    return rt_str_slice(o, x, x + 1)\n  \}\n  if k == K_BYTES \{\n    let n = mem_get(o + 8)\n    var x = rt_index_of(i, \"bytes\", n)\n    let orig = x\n    if x < 0 \{ x = x + n \}\n    if x < 0 or x >= n \{ rt_range_error(orig, \"bytes\", n) \}\n    return rt_mknum(mem_get8(o + 16 + x))\n  \}\n  return rt_fail2(\"cannot index a \", rt_type_name(o))\n\}\nfn rt_setindex(o, i, v) \{\n  let k = rt_kind(o)\n  if k == K_MAP \{ return rt_map_set(o, i, v) \}\n  if k == K_LIST \{\n    let n = mem_get(o + 8)\n    var x = rt_index_of(i, \"list\", n)\n    let orig = x\n    if x < 0 \{ x = x + n \}\n    if x == n \{ return rt_list_push(o, v) \}\n    if x < 0 or x > n \{ rt_range_error(orig, \"list\", n) \}\n    mem_set(mem_get(o + 24) + x * 8, v)\n    return o\n  \}\n  return rt_fail2(\"cannot assign into a \", rt_type_name(o))\n\}\nfn rt_member(o, name) \{\n  if rt_kind(o) == K_MAP \{ return rt_map_get(o, name) \}\n  return rt_fail3(\"a \", rt_type_name(o), \" has no fields\")\n\}\nfn rt_setmember(o, name, v) \{\n  if rt_kind(o) == K_MAP \{ return rt_map_set(o, name, v) \}\n  return rt_fail3(\"a \", rt_type_name(o), \" has no fields\")\n\}\nfn rt_coalesce_null(a) \{ return a == NULL \}\n\n// ── for loops: everything iterates as a list ─────────────────────────────────\nfn rt_iter(c) \{\n  let k = rt_kind(c)\n  if k == K_LIST \{ return c \}\n  if k == K_MAP \{ return rt_b_keys(c) \}\n  if k == K_STR \{\n    let n = mem_get(c + 16)\n    let l = rt_list_new(n)\n    var i = 0\n    while i < n \{\n      rt_list_push(l, rt_str_slice(c, i, i + 1))\n      i = i + 1\n    \}\n    return l\n  \}\n  if k == K_BYTES \{\n    let n = mem_get(c + 8)\n    let l = rt_list_new(n)\n    var i = 0\n    while i < n \{\n      rt_list_push(l, rt_mknum(mem_get8(c + 16 + i)))\n      i = i + 1\n    \}\n    return l\n  \}\n  return rt_fail2(\"cannot iterate over a \", rt_type_name(c))\n\}\nfn rt_iter_second(c, i, item) \{\n  // the second loop variable: a map's value for its key; otherwise the item itself\n  if rt_kind(c) == K_MAP \{ return rt_map_get(c, item) \}\n  return item\n\}\nfn rt_iter_first(c, i, item) \{\n  // with two variables: a map gives its key; everything else its index\n  if rt_kind(c) == K_MAP \{ return item \}\n  return i\n\}\nfn rt_range_next(i) \{\n  if (i & 7) == 1 \{ return rt_mknum((i >> 3) + 1) \}\n  let v = rt_intval(i)\n  if add_ovf(v, 1) \{ rt_ovf(\"..\") \}\n  return rt_mkint(v + 1)\n\}\nfn rt_range_check(a, b) \{\n  if ((a & 7) == 1 and (b & 7) == 1) or (rt_is_int(a) and rt_is_int(b)) \{ return 0 \}\n  return rt_num_or_int_error(\"..\", a, b)\n\}\n\n// ── functions as values ──────────────────────────────────────────────────────\n// K_FN [kind][code address][most arguments][environment: a list of cells, or 0][name][fewest arguments]. A compiled\n// function receives its closure as a hidden last argument; a captured variable lives in a cell (one heap word) shared\n// by reference. Builtins used as values may take a range of arguments; they read how many from rt_nargs.\nfn rt_closure_new(code, nparams, env, name) \{\n  let f = rt_alloc(48)\n  mem_set(f, K_FN)\n  mem_set(f + 8, code)\n  mem_set(f + 16, nparams)\n  mem_set(f + 24, env)\n  mem_set(f + 32, name)\n  mem_set(f + 40, nparams)\n  return f\n\}\nfn rt_cell_new(v) \{\n  let c = rt_alloc(8)\n  mem_set(c, v)\n  return c\n\}\n// before calling a value: it must be a fn that takes nargs arguments; gives its code address\nfn rt_call_check(f, nargs) \{\n  if rt_kind(f) != K_FN \{ rt_fail3(\"cannot call \", rt_type_name(f), \" — only fn values can be called\") \}\n  let most = mem_get(f + 16)\n  let fewest = mem_get(f + 40)\n  if nargs < fewest or nargs > most \{\n    let sb = rt_sb_new()\n    rt_sb_str(sb, mem_get(f + 32))\n    rt_sb_str(sb, \" takes \")\n    rt_sb_dec(sb, fewest)\n    if most != fewest \{\n      rt_sb_str(sb, \" to \")\n      rt_sb_dec(sb, most)\n    \}\n    rt_sb_str(sb, \" argument(s), got \")\n    rt_sb_dec(sb, nargs)\n    rt_die_lit(rt_sb_done(sb))\n  \}\n  rt_nargs = nargs\n  return mem_get(f + 8)\n\}\nfn rt_b_truthy(v, who) \{\n  if v == TRUE \{ return TRUE \}\n  if v == FALSE \{ return FALSE \}\n  let sb = rt_sb_new()\n  rt_sb_str(sb, rt_tostr(who))\n  rt_sb_str(sb, \" needs a bool, got \")\n  rt_sb_str(sb, rt_type_name(v))\n  rt_sb_byte(sb, 32)\n  rt_show_into(sb, v, 1)\n  return rt_die_lit(rt_sb_done(sb))\n\}\nfn rt_pow(a, b) \{\n  if rt_is_int(a) and rt_is_int(b) \{\n    let x = rt_intval(a)\n    var y = rt_intval(b)\n    if y < 0 \{ rt_fail(\"int ** needs a non-negative exponent\") \}\n    if x == 0 or x == 1 \{\n      if y == 0 \{ return rt_mkint(1) \}\n      return a\n    \}\n    if x == -1 \{\n      if (y & 1) == 0 \{ return rt_mkint(1) \}\n      return a\n    \}\n    if y > 63 \{ rt_fail(\"int overflow in **: result does not fit in 64 bits\") \}\n    var r = 1\n    while y > 0 \{\n      if mul_ovf(r, x) \{ rt_ovf(\"**\") \}\n      r = r * x\n      y = y - 1\n    \}\n    return rt_mkint(r)\n  \}\n  if (a & 7) == 1 and (b & 7) == 1 \{ return rt_num_pow(a, b) \}\n  if rt_fl2(a, b) \{ return rt_unsupported(\"** with a fractional num\") \}\n  return rt_num_or_int_error(\"**\", a, b)\n\}\n\n// ── builtins ─────────────────────────────────────────────────────────────────\nfn rt_b_len(x) \{\n  let k = rt_kind(x)\n  if k == K_STR \{ return rt_mknum(mem_get(x + 16)) \}\n  if k == K_LIST or k == K_MAP or k == K_BYTES \{ return rt_mknum(mem_get(x + 8)) \}\n  return rt_fail2(\"len needs a string, list or map, got \", rt_type_name(x))\n\}\nfn rt_b_byte_len(x) \{\n  let k = rt_kind(x)\n  if k == K_STR or k == K_BYTES \{ return rt_mknum(mem_get(x + 8)) \}\n  return rt_fail2(\"byte_len needs a string or bytes, got \", rt_type_name(x))\n\}\nfn rt_b_str(x) \{ return rt_show(x, 0) \}\nfn rt_b_repr(x) \{ return rt_show(x, 1) \}\nfn rt_b_type_of(x) \{ return rt_type_name(x) \}\n// JavaScript's white space (String.prototype.trim): the byte length of the white-space character starting at p + i\n// (ASCII tab..CR and space; U+00A0, U+1680, U+2000–U+200A, U+2028, U+2029, U+202F, U+205F, U+3000, U+FEFF), else 0\nfn rt_ws_at(p, i, n) \{\n  let c = mem_get8(p + i)\n  if c == 32 or (c >= 9 and c <= 13) \{ return 1 \}\n  if c == 194 and i + 1 < n and mem_get8(p + i + 1) == 160 \{ return 2 \}\n  if i + 2 >= n \{ return 0 \}\n  let c1 = mem_get8(p + i + 1)\n  let c2 = mem_get8(p + i + 2)\n  if c == 225 and c1 == 154 and c2 == 128 \{ return 3 \}\n  if c == 226 and c1 == 128 and ((c2 >= 128 and c2 <= 138) or c2 == 168 or c2 == 169 or c2 == 175) \{ return 3 \}\n  if c == 226 and c1 == 129 and c2 == 159 \{ return 3 \}\n  if c == 227 and c1 == 128 and c2 == 128 \{ return 3 \}\n  if c == 239 and c1 == 187 and c2 == 191 \{ return 3 \}\n  return 0\n\}\n// the byte length of a white-space character ending at p + n\nfn rt_ws_before(p, n) \{\n  if n >= 1 and rt_ws_at(p, n - 1, n) == 1 \{ return 1 \}\n  if n >= 2 and rt_ws_at(p, n - 2, n) == 2 \{ return 2 \}\n  if n >= 3 and rt_ws_at(p, n - 3, n) == 3 \{ return 3 \}\n  return 0\n\}\nvar rt_trim_lo = 0\nvar rt_trim_hi = 0\n// sets rt_trim_lo / rt_trim_hi to the string's bytes without white space at either end\nfn rt_trim_range(s) \{\n  let p = s + 24\n  var i = 0\n  var n = mem_get(s + 8)\n  while i < n and rt_ws_at(p, i, n) > 0 \{ i = i + rt_ws_at(p, i, n) \}\n  while n > i and rt_ws_before(p, n) > 0 \{ n = n - rt_ws_before(p, n) \}\n  rt_trim_lo = i\n  rt_trim_hi = n\n  return 0\n\}\n// int(string): trimmed, then an optional sign and decimal digits, as the interpreter's /^[+-]?[0-9]+$/\nfn rt_parse_int(s, what) \{\n  rt_trim_range(s)\n  var i = rt_trim_lo\n  let n = rt_trim_hi\n  var neg = 0\n  if i < n and (mem_get8(s + 24 + i) == 45 or mem_get8(s + 24 + i) == 43) \{\n    if mem_get8(s + 24 + i) == 45 \{ neg = 1 \}\n    i = i + 1\n  \}\n  if i >= n \{ rt_fail3(what, \" cannot read \", rt_show(s, 1)) \}\n  var v = 0\n  while i < n \{\n    let c = mem_get8(s + 24 + i)\n    if c < 48 or c > 57 \{ rt_fail3(what, \" cannot read \", rt_show(s, 1)) \}\n    if mul_ovf(v, 10) or sub_ovf(v * 10, c - 48) \{ rt_ovf(\"int()\") \}\n    v = v * 10 - (c - 48)\n    i = i + 1\n  \}\n  if neg \{ return v \}\n  if sub_ovf(0, v) \{ rt_ovf(\"int()\") \}\n  return 0 - v\n\}\nfn rt_b_int(x) \{\n  if (x & 7) == 1 \{ return rt_mkint(x >> 3) \}\n  if rt_is_int(x) \{ return x \}\n  if rt_is_flt(x) \{\n    let b = mem_get(x + 8)\n    if not rt_f_finite(b) \{ rt_fail2(\"int cannot convert \", rt_show(x, 0)) \}\n    if not f_lt(rt_f_abs(b), F_TWO63) \{ rt_ovf(\"int()\") \}\n    return rt_mkint(f_trunc(b))\n  \}\n  if rt_kind(x) == K_STR \{ return rt_mkint(rt_parse_int(x, \"int\")) \}\n  return rt_fail2(\"int needs a num, an int or a string, got \", rt_type_name(x))\n\}\nfn rt_b_num(x) \{\n  if (x & 7) == 1 or rt_is_flt(x) \{ return x \}\n  if rt_is_int(x) \{\n    // exact, or refused as the interpreter refuses it\n    let v = rt_intval(x)\n    let d = f_of_int(v)\n    if f_lt(rt_f_abs(d), F_TWO63) and f_trunc(d) == v \{ return rt_fnum(d) \}\n    return rt_fail3(\"num(\", rt_show(x, 0), \"): an int above 2^53 is not exactly representable as num\")\n  \}\n  if rt_kind(x) == K_STR \{\n    let d = rt_parse_double(x)\n    if not rt_pn_ok \{ rt_fail3(\"num\", \" cannot read \", rt_show(x, 1)) \}\n    return rt_fnum(d)\n  \}\n  return rt_fail2(\"num needs a num, an int or a string, got \", rt_type_name(x))\n\}\nfn rt_b_has(m, k) \{\n  if rt_kind(m) == K_MAP \{ return rt_bool(rt_kind(k) == K_STR and rt_map_find(m, k) >= 0) \}\n  return rt_fail2(\"has needs a map, got \", rt_type_name(m))\n\}\nfn rt_b_get(m, k, d) \{\n  if rt_kind(m) == K_MAP \{\n    if rt_kind(k) != K_STR \{ return d \}\n    let e = rt_map_find(m, k)\n    if e < 0 \{ return d \}\n    return mem_get(mem_get(m + 32) + e * 8)\n  \}\n  if rt_kind(m) == K_LIST \{\n    let n = mem_get(m + 8)\n    var x = rt_index_num(k)\n    if x < 0 \{ x = x + n \}\n    if x < 0 or x >= n \{ return d \}\n    return rt_list_get(m, x)\n  \}\n  return rt_fail2(\"get needs a map or a list, got \", rt_type_name(m))\n\}\nfn rt_b_keys(m) \{\n  if rt_kind(m) != K_MAP \{ rt_fail2(\"keys needs a map, got \", rt_type_name(m)) \}\n  let n = mem_get(m + 8)\n  let l = rt_list_new(n)\n  var i = 0\n  while i < n \{\n    rt_list_push(l, mem_get(mem_get(m + 24) + i * 8))\n    i = i + 1\n  \}\n  return l\n\}\nfn rt_b_values(m) \{\n  if rt_kind(m) != K_MAP \{ rt_fail2(\"values needs a map, got \", rt_type_name(m)) \}\n  let n = mem_get(m + 8)\n  let l = rt_list_new(n)\n  var i = 0\n  while i < n \{\n    rt_list_push(l, mem_get(mem_get(m + 32) + i * 8))\n    i = i + 1\n  \}\n  return l\n\}\nfn rt_clamp(x, n) \{\n  var v = x\n  if v < 0 \{ v = v + n \}\n  if v < 0 \{ v = 0 \}\n  if v > n \{ v = n \}\n  return v\n\}\nfn rt_b_slice(x, a, b) \{\n  let k = rt_kind(x)\n  var n = 0\n  if k == K_STR \{ n = mem_get(x + 16) \} else if k == K_LIST or k == K_BYTES \{ n = mem_get(x + 8) \} else \{\n    rt_fail2(\"slice needs a string, list or bytes, got \", rt_type_name(x))\n  \}\n  let s = rt_clamp(rt_index_num(a), n)\n  var e = n\n  if b != NULL \{ e = rt_clamp(rt_index_num(b), n) \}\n  if e < s \{ e = s \}\n  if k == K_STR \{ return rt_str_slice(x, s, e) \}\n  if k == K_BYTES \{\n    let r = rt_bytes_new(e - s)\n    mem_copy(r + 16, x + 16 + s, e - s)\n    return r\n  \}\n  let l = rt_list_new(e - s)\n  var i = s\n  while i < e \{\n    rt_list_push(l, rt_list_get(x, i))\n    i = i + 1\n  \}\n  return l\n\}\nfn rt_b_push(l, v) \{\n  if rt_kind(l) != K_LIST \{ rt_fail2(\"push needs a list, got \", rt_type_name(l)) \}\n  let n = mem_get(l + 8)\n  let r = rt_list_new(n + 1)\n  var i = 0\n  while i < n \{\n    rt_list_push(r, rt_list_get(l, i))\n    i = i + 1\n  \}\n  return rt_list_push(r, v)\n\}\nfn rt_b_bytes(x) \{\n  let sb = rt_sb_new()\n  rt_bytes_flatten(sb, x)\n  let n = mem_get(sb + 8)\n  let r = rt_bytes_new(n)\n  mem_copy(r + 16, mem_get(sb), n)\n  return r\n\}\nfn rt_b_range(a, b, step) \{\n  var lo = a\n  var hi = b\n  var st = step\n  if hi == NULL \{\n    hi = lo\n    lo = 1          // the num 0, tagged\n  \}\n  if st == NULL \{ st = 9 \}          // the num 1, tagged\n  if (lo & 7) != 1 or (hi & 7) != 1 or (st & 7) != 1 \{ rt_fail(\"range needs ints\") \}\n  let s = st >> 3\n  if s == 0 \{ rt_fail(\"range step cannot be 0\") \}\n  let l = rt_list_new(0)\n  var i = lo >> 3\n  let e = hi >> 3\n  if s > 0 \{\n    while i < e \{\n      rt_list_push(l, rt_mknum(i))\n      i = i + s\n    \}\n  \} else \{\n    while i > e \{\n      rt_list_push(l, rt_mknum(i))\n      i = i + s\n    \}\n  \}\n  return l\n\}\nfn rt_b_join(l, sep) \{\n  if rt_kind(l) != K_LIST \{ rt_fail2(\"join needs a list, got \", rt_type_name(l)) \}\n  let sb = rt_sb_new()\n  let n = mem_get(l + 8)\n  var i = 0\n  while i < n \{\n    if i > 0 and sep != NULL \{\n      if rt_kind(sep) != K_STR \{ rt_fail2(\"join needs a string separator, got \", rt_type_name(sep)) \}\n      rt_sb_str(sb, sep)\n    \}\n    rt_sb_str(sb, rt_tostr(rt_list_get(l, i)))\n    i = i + 1\n  \}\n  return rt_sb_done(sb)\n\}\nfn rt_need_str(s, who) \{\n  if rt_kind(s) != K_STR \{ rt_fail3(who, \" needs a string, got \", rt_type_name(s)) \}\n  return s\n\}\n// code points before byte offset off\nfn rt_cp_count(s, off) \{\n  var c = 0\n  var i = 0\n  while i < off \{\n    if (mem_get8(s + 24 + i) & 192) != 128 \{ c = c + 1 \}\n    i = i + 1\n  \}\n  return c\n\}\nfn rt_b_split(s, sep) \{\n  rt_need_str(s, \"split\")\n  rt_need_str(sep, \"split\")\n  let n = mem_get(s + 8)\n  let m = mem_get(sep + 8)\n  let l = rt_list_new(0)\n  if m == 0 \{\n    // every code point\n    var i = 0\n    while i < n \{\n      var j = i + 1\n      while j < n and (mem_get8(s + 24 + j) & 192) == 128 \{ j = j + 1 \}\n      rt_list_push(l, rt_str_from(s + 24 + i, j - i))\n      i = j\n    \}\n    return l\n  \}\n  var start = 0\n  var i = 0\n  while i + m <= n \{\n    var k = 0\n    while k < m and mem_get8(s + 24 + i + k) == mem_get8(sep + 24 + k) \{ k = k + 1 \}\n    if k == m \{\n      rt_list_push(l, rt_str_from(s + 24 + start, i - start))\n      i = i + m\n      start = i\n    \} else \{\n      i = i + 1\n    \}\n  \}\n  rt_list_push(l, rt_str_from(s + 24 + start, n - start))\n  return l\n\}\nfn rt_b_find_text(s, sub) \{\n  rt_need_str(s, \"find_text\")\n  rt_need_str(sub, \"find_text\")\n  let at = rt_str_find(s, sub)\n  if at < 0 \{ return rt_mknum(-1) \}\n  return rt_mknum(rt_cp_count(s, at))\n\}\nfn rt_b_raise(msg) \{ return rt_die_lit(rt_tostr(msg)) \}\nfn rt_b_sqrt(x) \{\n  if not rt_isnum(x) \{ rt_fail2(\"sqrt needs a num, got \", rt_type_name(x)) \}\n  let b = rt_fbits(x)\n  if f_lt(b, 0) \{ rt_fail(\"sqrt of a negative num\") \}\n  return rt_fnum(f_sqrt(b))\n\}\nfn rt_b_floor(x) \{\n  if (x & 7) == 1 \{ return x \}\n  if rt_is_flt(x) \{ return rt_fnum(rt_f_floor(mem_get(x + 8))) \}\n  return rt_fail2(\"floor needs a num, got \", rt_type_name(x))\n\}\n// min / max: of their arguments, or of one list argument. All ints → an int; otherwise every value must be a num.\nfn rt_minmax(args, want_max, who) \{\n  var xs = args\n  if mem_get(args + 8) == 1 and rt_kind(rt_list_get(args, 0)) == K_LIST \{ xs = rt_list_get(args, 0) \}\n  let n = mem_get(xs + 8)\n  if n == 0 \{ rt_fail2(who, \" of nothing\") \}\n  var all_int = 1\n  var i = 0\n  while i < n \{\n    let v = rt_list_get(xs, i)\n    if not rt_is_int(v) \{ all_int = 0 \}\n    i = i + 1\n  \}\n  if not all_int \{\n    i = 0\n    while i < n \{\n      if not rt_isnum(rt_list_get(xs, i)) \{ rt_fail3(who, \" needs a num, got \", rt_type_name(rt_list_get(xs, i))) \}\n      if rt_is_flt(rt_list_get(xs, i)) and not f_eq(rt_fbits(rt_list_get(xs, i)), rt_fbits(rt_list_get(xs, i))) \{ return rt_list_get(xs, i) \}\n      i = i + 1\n    \}\n  \}\n  var best = rt_list_get(xs, 0)\n  i = 1\n  while i < n \{\n    let v = rt_list_get(xs, i)\n    let c = rt_order(who, v, best)\n    if (want_max and c > 0) or (not want_max and c < 0) \{ best = v \}\n    i = i + 1\n  \}\n  return best\n\}\nfn rt_b_min(args) \{ return rt_minmax(args, 0, \"min\") \}\nfn rt_b_max(args) \{ return rt_minmax(args, 1, \"max\") \}\n\n// utf8(bytes) → string. Strict (CIE-EG 2.2): overlong forms, surrogates, code points above U+10FFFF, bad continuation\n// bytes and truncated sequences are refused, naming the offset of the first byte of the bad sequence.\nfn rt_utf8_len(b0) \{\n  if b0 <= 127 \{ return 1 \}\n  if b0 >= 194 and b0 <= 223 \{ return 2 \}\n  if b0 >= 224 and b0 <= 239 \{ return 3 \}\n  if b0 >= 240 and b0 <= 244 \{ return 4 \}\n  return 0\n\}\nfn rt_utf8_bad(at) \{\n  let sb = rt_sb_new()\n  rt_sb_str(sb, \"invalid UTF-8 at byte \")\n  rt_sb_dec(sb, at)\n  return rt_die_lit(rt_sb_done(sb))\n\}\nfn rt_b_utf8(v) \{\n  if rt_kind(v) != K_BYTES \{ rt_fail2(\"utf8 needs bytes, got \", rt_type_name(v)) \}\n  let n = mem_get(v + 8)\n  let p = v + 16\n  var i = 0\n  while i < n \{\n    let b0 = mem_get8(p + i)\n    let k = rt_utf8_len(b0)\n    if k == 0 or i + k > n \{ rt_utf8_bad(i) \}\n    var cp = b0\n    if k == 2 \{ cp = b0 & 31 \}\n    if k == 3 \{ cp = b0 & 15 \}\n    if k == 4 \{ cp = b0 & 7 \}\n    var j = 1\n    while j < k \{\n      let c = mem_get8(p + i + j)\n      if (c & 192) != 128 \{ rt_utf8_bad(i) \}\n      cp = (cp << 6) | (c & 63)\n      j = j + 1\n    \}\n    if (k == 2 and cp < 128) or (k == 3 and cp < 2048) or (k == 4 and cp < 65536) \{ rt_utf8_bad(i) \}\n    if (cp >= 55296 and cp <= 57343) or cp > 1114111 \{ rt_utf8_bad(i) \}\n    i = i + k\n  \}\n  return rt_str_from(p, n)\n\}\n\n// ── files and arguments ──────────────────────────────────────────────────────\nfn rt_cpath(s) \{\n  if rt_kind(s) != K_STR \{ rt_fail2(\"a path must be a string, got \", rt_type_name(s)) \}\n  let n = mem_get(s + 8)\n  let p = rt_alloc(n + 1)\n  mem_copy(p, s + 24, n)\n  mem_set8(p + n, 0)\n  return p\n\}\nfn rt_read_all(path) \{\n  let fd = sys6(2, rt_cpath(path), 0, 0, 0, 0)\n  if fd < 0 \{ rt_fail2(\"cannot read \", rt_tostr(path)) \}\n  let sb = rt_sb_new()\n  while 1 \{\n    rt_sb_room(sb, 65536)\n    let r = sys6(0, fd, mem_get(sb) + mem_get(sb + 8), 65536, 0, 0)\n    if r < 0 \{ rt_fail2(\"cannot read \", rt_tostr(path)) \}\n    if r == 0 \{ break \}\n    mem_set(sb + 8, mem_get(sb + 8) + r)\n  \}\n  sys6(3, fd, 0, 0, 0, 0)\n  return sb\n\}\nfn rt_b_read_file(path) \{\n  let sb = rt_read_all(path)\n  return rt_str_from(mem_get(sb), mem_get(sb + 8))\n\}\nfn rt_b_read_bytes(path) \{\n  let sb = rt_read_all(path)\n  let n = mem_get(sb + 8)\n  let r = rt_bytes_new(n)\n  mem_copy(r + 16, mem_get(sb), n)\n  return r\n\}\nfn rt_write_path(path, p, n) \{\n  // open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)\n  let fd = sys6(2, rt_cpath(path), 577, 420, 0, 0)\n  if fd < 0 \{ rt_fail2(\"cannot write \", rt_tostr(path)) \}\n  rt_write(fd, p, n)\n  sys6(3, fd, 0, 0, 0, 0)\n  return NULL\n\}\nfn rt_b_write_file(path, text) \{\n  let s = rt_tostr(text)\n  return rt_write_path(path, s + 24, mem_get(s + 8))\n\}\nfn rt_b_write_bytes(path, b) \{\n  if rt_kind(b) != K_BYTES \{ rt_fail2(\"write_bytes needs bytes, got \", rt_type_name(b)) \}\n  return rt_write_path(path, b + 16, mem_get(b + 8))\n\}\nfn rt_b_chmod_exec(path) \{\n  sys6(90, rt_cpath(path), 493, 0, 0, 0)\n  return NULL\n\}\nfn rt_b_args() \{\n  let argc = mem_get(rt_sp)\n  let l = rt_list_new(argc)\n  var i = 1\n  while i < argc \{\n    let p = mem_get(rt_sp + 8 + i * 8)\n    var n = 0\n    while mem_get8(p + n) != 0 \{ n = n + 1 \}\n    rt_list_push(l, rt_str_from(p, n))\n    i = i + 1\n  \}\n  return l\n\}\nfn rt_exit(code) \{\n  sys6(60, code, 0, 0, 0, 0)\n  return 0\n\}\n\n// ── fractional nums (GATE-NL-004, 2026-10-31): IEEE doubles, from the former native/float_draft.eg ──────\n\n// ── fractional nums: IEEE doubles ────────────────────────────────────────────\n// A num is the tagged form when its value is an integer within 2^53 (then it is exact in both forms, and -0 is 0);\n// any other double — fractions, larger values, NaN, ±Infinity — is boxed: [K_FLT][64-bit pattern]. Arithmetic follows\n// IEEE round-to-nearest-even through SSE2, so results are the interpreter's (JavaScript's) to the last bit; printing is\n// JavaScript's Number.prototype.toString (shortest round-trip digits, Steele-White/Dragon4 with exact bignums) and\n// parsing is correctly rounded.\nlet MANT = 4503599627370495            // 2^52 - 1\nlet HIDDEN = 4503599627370496          // 2^52\nlet F_NAN = 9221120237041090560i       // 0x7FF8000000000000\nlet F_INF = 9218868437227405312i       // 0x7FF0000000000000\nlet F_HALF = 4602678819172646912i      // 0.5\nlet F_TWO52 = 4841369599423283200i     // 2^52\nlet F_TWO63 = 4890909195324358656i     // 2^63\n\nfn rt_sign_bit() \{ return 1 << 63 \}\nfn rt_is_flt(v) \{ return rt_kind(v) == K_FLT \}\nfn rt_isnum(v) \{ return (v & 7) == 1 or rt_kind(v) == K_FLT \}\n// the double of a num\nfn rt_fbits(v) \{\n  if (v & 7) == 1 \{ return f_of_int(v >> 3) \}\n  return mem_get(v + 8)\n\}\nfn rt_fbox(b) \{\n  let p = rt_alloc(16)\n  mem_set(p, K_FLT)\n  mem_set(p + 8, b)\n  return p\n\}\n// a double as a num value\nfn rt_fnum(b) \{\n  let mag = b & (rt_sign_bit() - 1)\n  if mag == 0 \{ return 1 \}\n  let ex = shr_u(mag, 52)\n  if ex >= 1023 and ex <= 1076 \{\n    let m = (mag & MANT) | HIDDEN\n    let e = ex - 1075\n    var v = 0\n    if e >= 0 \{\n      v = m << e\n    \} else \{\n      if (m & ((1 << (0 - e)) - 1)) != 0 \{ return rt_fbox(b) \}\n      v = m >> (0 - e)\n    \}\n    if v <= NUM_MAX \{\n      if b < 0 \{ return (0 - v) * 8 + 1 \}\n      return v * 8 + 1\n    \}\n  \}\n  return rt_fbox(b)\n\}\nfn rt_f_finite(b) \{ return (shr_u(b, 52) & 2047) != 2047 \}\nfn rt_f_abs(b) \{ return b & (rt_sign_bit() - 1) \}\n// Number.isInteger: finite and its own floor\nfn rt_f_whole(b) \{ return rt_f_finite(b) and rt_f_floor(b) == b \}\n\n// floor of a double, as a double (|x| >= 2^52, NaN and infinities are their own floor)\nfn rt_f_floor(b) \{\n  if not f_lt(rt_f_abs(b), F_TWO52) \{ return b \}\n  let t = f_trunc(b)\n  var r = f_of_int(t)\n  if f_lt(b, r) \{ r = f_of_int(t - 1) \}\n  if r == 0 and b < 0 \{ return rt_sign_bit() \}\n  return r\n\}\nfn rt_f_ceil(b) \{\n  let n = rt_f_floor(b ^ rt_sign_bit())\n  return n ^ rt_sign_bit()\n\}\n// JavaScript's Math.round: the nearest integer, halves toward +Infinity\nfn rt_f_round(b) \{\n  if not f_lt(rt_f_abs(b), F_TWO52) \{ return b \}\n  let fl = rt_f_floor(b)\n  if f_le(F_HALF, f_sub(b, fl)) \{ return f_add(fl, f_of_int(1)) \}\n  return fl\n\}\n\n// fmod on 64-bit patterns, exactly (the remainder of x / y with x's sign, as C's fmod and JavaScript's %)\nfn rt_ult(a, b) \{ return (a ^ rt_sign_bit()) < (b ^ rt_sign_bit()) \}\nfn rt_fmod(x, y) \{\n  var ux = x\n  var uy = y\n  var ex = shr_u(ux, 52) & 2047\n  var ey = shr_u(uy, 52) & 2047\n  let sx = ux & rt_sign_bit()\n  let ax = ux << 1\n  let ay = uy << 1\n  if ay == 0 or ex == 2047 \{ return F_NAN \}\n  if ey == 2047 \{\n    if (uy & MANT) != 0 \{ return F_NAN \}\n    return x\n  \}\n  if not rt_ult(ay, ax) \{\n    if ax == ay \{ return sx \}\n    return x\n  \}\n  if ex == 0 \{\n    var i = ux << 12\n    while i >= 0 \{\n      ex = ex - 1\n      i = i << 1\n    \}\n    ux = ux << (1 - ex)\n  \} else \{\n    ux = (ux & MANT) | HIDDEN\n  \}\n  if ey == 0 \{\n    var i = uy << 12\n    while i >= 0 \{\n      ey = ey - 1\n      i = i << 1\n    \}\n    uy = uy << (1 - ey)\n  \} else \{\n    uy = (uy & MANT) | HIDDEN\n  \}\n  while ex > ey \{\n    let i = ux - uy\n    if i >= 0 \{\n      if i == 0 \{ return sx \}\n      ux = i\n    \}\n    ux = ux << 1\n    ex = ex - 1\n  \}\n  let i = ux - uy\n  if i >= 0 \{\n    if i == 0 \{ return sx \}\n    ux = i\n  \}\n  while shr_u(ux, 52) == 0 \{\n    ux = ux << 1\n    ex = ex - 1\n  \}\n  if ex > 0 \{\n    ux = ux - HIDDEN\n    ux = ux | (ex << 52)\n  \} else \{\n    ux = shr_u(ux, 1 - ex)\n  \}\n  return ux | sx\n\}\n\n// ── bignums for exact conversions: [length][capacity][32-bit limbs, little-endian, one per 8-byte slot] ────────\nlet MASK32 = 4294967295\nfn bn_new(cap) \{\n  let b = rt_alloc(16 + cap * 8)\n  mem_set(b, 0)\n  mem_set(b + 8, cap)\n  return b\n\}\nfn bn_limb(b, i) \{ return mem_get(b + 16 + i * 8) \}\nfn bn_setl(b, i, v) \{ return mem_set(b + 16 + i * 8, v) \}\nfn bn_need(b, n) \{\n  if n > mem_get(b + 8) \{ rt_die_lit(\"native: a number too large to convert\") \}\n  return 0\n\}\nfn bn_trim(b) \{\n  var n = mem_get(b)\n  while n > 0 and bn_limb(b, n - 1) == 0 \{ n = n - 1 \}\n  return mem_set(b, n)\n\}\nfn bn_from(b, v) \{\n  var x = v\n  var i = 0\n  while x != 0 \{\n    bn_setl(b, i, x & MASK32)\n    x = shr_u(x, 32)\n    i = i + 1\n  \}\n  mem_set(b, i)\n  return b\n\}\nfn bn_copy(dst, src) \{\n  let n = mem_get(src)\n  bn_need(dst, n)\n  mem_copy(dst + 16, src + 16, n * 8)\n  mem_set(dst, n)\n  return dst\n\}\nfn bn_mul_small(b, k) \{\n  let n = mem_get(b)\n  var c = 0\n  var i = 0\n  while i < n \{\n    let t = bn_limb(b, i) * k + c\n    bn_setl(b, i, t & MASK32)\n    c = shr_u(t, 32)\n    i = i + 1\n  \}\n  if c != 0 \{\n    bn_need(b, n + 1)\n    bn_setl(b, n, c)\n    mem_set(b, n + 1)\n  \}\n  return b\n\}\nfn bn_mul_pow10(b, e) \{\n  var k = e\n  while k >= 9 \{\n    bn_mul_small(b, 1000000000)\n    k = k - 9\n  \}\n  var p = 1\n  while k > 0 \{\n    p = p * 10\n    k = k - 1\n  \}\n  if p > 1 \{ bn_mul_small(b, p) \}\n  return b\n\}\nfn bn_shl(b, s) \{\n  let n = mem_get(b)\n  if n == 0 or s == 0 \{ return b \}\n  let w = s >> 5\n  let r = s & 31\n  bn_need(b, n + w + 1)\n  var top = 0\n  if r > 0 \{ top = shr_u(bn_limb(b, n - 1), 32 - r) \}\n  bn_setl(b, n + w, top)\n  var i = n - 1\n  while i >= 0 \{\n    var v = (bn_limb(b, i) << r) & MASK32\n    if r > 0 and i > 0 \{ v = v | shr_u(bn_limb(b, i - 1), 32 - r) \}\n    bn_setl(b, i + w, v)\n    i = i - 1\n  \}\n  i = 0\n  while i < w \{\n    bn_setl(b, i, 0)\n    i = i + 1\n  \}\n  mem_set(b, n + w + 1)\n  return bn_trim(b)\n\}\nfn bn_shr1(b) \{\n  let n = mem_get(b)\n  var i = 0\n  while i < n \{\n    var v = shr_u(bn_limb(b, i), 1)\n    if i + 1 < n \{ v = v | ((bn_limb(b, i + 1) & 1) << 31) \}\n    bn_setl(b, i, v)\n    i = i + 1\n  \}\n  return bn_trim(b)\n\}\nfn bn_cmp(a, b) \{\n  let na = mem_get(a)\n  let nb = mem_get(b)\n  if na != nb \{\n    if na < nb \{ return -1 \}\n    return 1\n  \}\n  var i = na - 1\n  while i >= 0 \{\n    let x = bn_limb(a, i)\n    let y = bn_limb(b, i)\n    if x != y \{\n      if x < y \{ return -1 \}\n      return 1\n    \}\n    i = i - 1\n  \}\n  return 0\n\}\n// a -= b (a >= b)\nfn bn_sub(a, b) \{\n  let n = mem_get(a)\n  let m = mem_get(b)\n  var br = 0\n  var i = 0\n  while i < n \{\n    var t = bn_limb(a, i) - br\n    if i < m \{ t = t - bn_limb(b, i) \}\n    if t < 0 \{\n      t = t + 4294967296\n      br = 1\n    \} else \{\n      br = 0\n    \}\n    bn_setl(a, i, t)\n    i = i + 1\n  \}\n  return bn_trim(a)\n\}\n// dst = a + b (dst may be a)\nfn bn_add(dst, a, b) \{\n  let na = mem_get(a)\n  let nb = mem_get(b)\n  var n = na\n  if nb > n \{ n = nb \}\n  bn_need(dst, n + 1)\n  var c = 0\n  var i = 0\n  while i < n \{\n    var t = c\n    if i < na \{ t = t + bn_limb(a, i) \}\n    if i < nb \{ t = t + bn_limb(b, i) \}\n    bn_setl(dst, i, t & MASK32)\n    c = shr_u(t, 32)\n    i = i + 1\n  \}\n  bn_setl(dst, n, c)\n  mem_set(dst, n + 1)\n  return bn_trim(dst)\n\}\nfn bn_bitlen(b) \{\n  let n = mem_get(b)\n  if n == 0 \{ return 0 \}\n  var top = bn_limb(b, n - 1)\n  var bits = 0\n  while top != 0 \{\n    bits = bits + 1\n    top = shr_u(top, 1)\n  \}\n  return (n - 1) * 32 + bits\n\}\n\n// ── double → shortest decimal (Dragon4 free-format, as V8's bignum-dtoa) ────\nvar rt_digits = 0        // 24 bytes of digits\nvar rt_ndigits = 0\nvar rt_dexp = 0          // the value is 0.d1d2… × 10^rt_dexp\nfn rt_shortest(bits) \{\n  let ex = shr_u(bits, 52) & 2047\n  var m = bits & MANT\n  var q = -1074\n  if ex != 0 \{\n    m = m | HIDDEN\n    q = ex - 1075\n  \}\n  let even = (m & 1) == 0\n  let closer = ex > 1 and (bits & MANT) == 0\n  let r = bn_new(48)\n  let s = bn_new(48)\n  let mp = bn_new(48)\n  let mm = bn_new(48)\n  bn_from(r, m)\n  if q >= 0 \{\n    if closer \{\n      bn_shl(r, q + 2)\n      bn_from(s, 4)\n      bn_from(mp, 1)\n      bn_shl(mp, q + 1)\n    \} else \{\n      bn_shl(r, q + 1)\n      bn_from(s, 2)\n      bn_from(mp, 1)\n      bn_shl(mp, q)\n    \}\n    bn_from(mm, 1)\n    bn_shl(mm, q)\n  \} else \{\n    bn_from(s, 1)\n    if closer \{\n      bn_shl(r, 2)\n      bn_shl(s, 2 - q)\n      bn_from(mp, 2)\n    \} else \{\n      bn_shl(r, 1)\n      bn_shl(s, 1 - q)\n      bn_from(mp, 1)\n    \}\n    bn_from(mm, 1)\n  \}\n  // estimate the decimal exponent, then correct it exactly\n  var bl = 0\n  var mt = m\n  while mt != 0 \{\n    bl = bl + 1\n    mt = shr_u(mt, 1)\n  \}\n  let e2 = q + bl - 1\n  var n = ((e2 * 78913) >> 18) + 1\n  if n >= 0 \{\n    bn_mul_pow10(s, n)\n  \} else \{\n    bn_mul_pow10(r, 0 - n)\n    bn_mul_pow10(mp, 0 - n)\n    bn_mul_pow10(mm, 0 - n)\n  \}\n  let t = bn_new(48)\n  while 1 \{\n    bn_add(t, r, mp)\n    let c = bn_cmp(t, s)\n    if c > 0 or (even and c == 0) \{\n      bn_mul_small(s, 10)\n      n = n + 1\n    \} else \{\n      break\n    \}\n  \}\n  while 1 \{\n    bn_add(t, r, mp)\n    bn_mul_small(t, 10)\n    let c = bn_cmp(t, s)\n    if c < 0 or (not even and c == 0) \{\n      bn_mul_small(r, 10)\n      bn_mul_small(mp, 10)\n      bn_mul_small(mm, 10)\n      n = n - 1\n    \} else \{\n      break\n    \}\n  \}\n  if rt_digits == 0 \{ rt_digits = rt_alloc(32) \}\n  var k = 0\n  while 1 \{\n    bn_mul_small(r, 10)\n    bn_mul_small(mp, 10)\n    bn_mul_small(mm, 10)\n    var d = 0\n    while bn_cmp(r, s) >= 0 \{\n      bn_sub(r, s)\n      d = d + 1\n    \}\n    let cl = bn_cmp(r, mm)\n    let low = cl < 0 or (even and cl == 0)\n    bn_add(t, r, mp)\n    let ch = bn_cmp(t, s)\n    let high = ch > 0 or (even and ch == 0)\n    if not low and not high \{\n      mem_set8(rt_digits + k, d)\n      k = k + 1\n    \} else \{\n      if low and high \{\n        bn_add(t, r, r)\n        let c2 = bn_cmp(t, s)\n        if c2 > 0 or (c2 == 0 and (d & 1) == 1) \{ d = d + 1 \}\n      \} else if high \{\n        d = d + 1\n      \}\n      mem_set8(rt_digits + k, d)\n      k = k + 1\n      break\n    \}\n  \}\n  rt_ndigits = k\n  rt_dexp = n\n  return 0\n\}\n// JavaScript's ToString for a double\nfn rt_sb_double(sb, bits) \{\n  var b = bits\n  if not rt_f_finite(b) \{\n    if (b & MANT) != 0 \{ return rt_sb_str(sb, \"NaN\") \}\n    if b < 0 \{ rt_sb_byte(sb, 45) \}\n    return rt_sb_str(sb, \"Infinity\")\n  \}\n  if b < 0 \{\n    b = rt_f_abs(b)\n    if b != 0 \{ rt_sb_byte(sb, 45) \}\n  \}\n  if b == 0 \{ return rt_sb_byte(sb, 48) \}\n  rt_shortest(b)\n  let k = rt_ndigits\n  let n = rt_dexp\n  var i = 0\n  if k <= n and n <= 21 \{\n    while i < k \{\n      rt_sb_byte(sb, 48 + mem_get8(rt_digits + i))\n      i = i + 1\n    \}\n    while i < n \{\n      rt_sb_byte(sb, 48)\n      i = i + 1\n    \}\n    return 0\n  \}\n  if 0 < n and n <= 21 \{\n    while i < k \{\n      if i == n \{ rt_sb_byte(sb, 46) \}\n      rt_sb_byte(sb, 48 + mem_get8(rt_digits + i))\n      i = i + 1\n    \}\n    return 0\n  \}\n  if -6 < n and n <= 0 \{\n    rt_sb_byte(sb, 48)\n    rt_sb_byte(sb, 46)\n    var z = 0\n    while z < 0 - n \{\n      rt_sb_byte(sb, 48)\n      z = z + 1\n    \}\n    while i < k \{\n      rt_sb_byte(sb, 48 + mem_get8(rt_digits + i))\n      i = i + 1\n    \}\n    return 0\n  \}\n  rt_sb_byte(sb, 48 + mem_get8(rt_digits))\n  if k > 1 \{\n    rt_sb_byte(sb, 46)\n    i = 1\n    while i < k \{\n      rt_sb_byte(sb, 48 + mem_get8(rt_digits + i))\n      i = i + 1\n    \}\n  \}\n  rt_sb_byte(sb, 101)\n  let e = n - 1\n  if e >= 0 \{\n    rt_sb_byte(sb, 43)\n    return rt_sb_dec(sb, e)\n  \}\n  rt_sb_byte(sb, 45)\n  return rt_sb_dec(sb, 0 - e)\n\}\n\n// ── decimal → double, correctly rounded ──────────────────────────────────────\n// d: the decimal digits as a bignum (not zero), e: the power of ten → the 64-bit pattern (positive)\nfn rt_dec_to_double(d, e) \{\n  let cap = 220\n  let r = bn_new(cap)\n  let s = bn_new(cap)\n  bn_copy(r, d)\n  bn_from(s, 1)\n  if e >= 0 \{ bn_mul_pow10(r, e) \} else \{ bn_mul_pow10(s, 0 - e) \}\n  var k = 53 - (bn_bitlen(r) - bn_bitlen(s))\n  let rk = bn_new(cap)\n  let sk = bn_new(cap)\n  let t = bn_new(cap)\n  var qv = 0\n  var tries = 0\n  while 1 \{\n    if k > 1074 \{ k = 1074 \}\n    bn_copy(rk, r)\n    bn_copy(sk, s)\n    if k >= 0 \{ bn_shl(rk, k) \} else \{ bn_shl(sk, 0 - k) \}\n    // binary long division: qv = rk / sk (fewer than 56 bits), rk = the remainder\n    bn_copy(t, sk)\n    bn_shl(t, 55)\n    qv = 0\n    var i = 55\n    while i >= 0 \{\n      if bn_cmp(rk, t) >= 0 \{\n        bn_sub(rk, t)\n        qv = qv | (1 << i)\n      \}\n      bn_shr1(t)\n      i = i - 1\n    \}\n    tries = tries + 1\n    if qv >= HIDDEN * 2 and tries < 4 \{\n      k = k - 1\n    \} else if qv < HIDDEN and k < 1074 and tries < 4 \{\n      k = k + 1\n    \} else \{\n      break\n    \}\n  \}\n  // round to nearest, ties to even\n  bn_add(t, rk, rk)\n  let c = bn_cmp(t, sk)\n  if c > 0 or (c == 0 and (qv & 1) == 1) \{ qv = qv + 1 \}\n  if qv == HIDDEN * 2 \{\n    qv = HIDDEN\n    k = k - 1\n  \}\n  if qv < HIDDEN \{ return qv \}\n  let biased = 1075 - k\n  if biased >= 2047 \{ return F_INF \}\n  return (biased << 52) | (qv - HIDDEN)\n\}\nvar rt_pn_ok = 0\n// JavaScript's Number(string), for what Emerge accepts: decimal (with fraction and exponent), 0x/0o/0b, Infinity;\n// surrounding white space is ignored. Sets rt_pn_ok; gives the 64-bit pattern.\nfn rt_parse_double(str) \{\n  rt_pn_ok = 0\n  let p = str + 24\n  rt_trim_range(str)\n  var i = rt_trim_lo\n  var n = rt_trim_hi\n  if i >= n \{ return 0 \}\n  var neg = 0\n  var signed = 0\n  let c0 = mem_get8(p + i)\n  if c0 == 43 or c0 == 45 \{\n    signed = 1\n    if c0 == 45 \{ neg = 1 \}\n    i = i + 1\n  \}\n  let rest = n - i\n  if rest == 8 and mem_get8(p + i) == 73 \{\n    // \"Infinity\"\n    let w = \"Infinity\"\n    var j = 0\n    while j < 8 and mem_get8(p + i + j) == mem_get8(w + 24 + j) \{ j = j + 1 \}\n    if j < 8 \{ return 0 \}\n    rt_pn_ok = 1\n    if neg \{ return F_INF | rt_sign_bit() \}\n    return F_INF\n  \}\n  let d = bn_new(120)\n  if not signed and rest > 2 and mem_get8(p + i) == 48 \{\n    let x = mem_get8(p + i + 1) | 32\n    var base = 0\n    if x == 120 \{ base = 16 \}\n    if x == 111 \{ base = 8 \}\n    if x == 98 \{ base = 2 \}\n    if base > 0 \{\n      i = i + 2\n      while i < n \{\n        let c = mem_get8(p + i)\n        var v = 99\n        if c >= 48 and c <= 57 \{ v = c - 48 \}\n        if (c | 32) >= 97 and (c | 32) <= 102 \{ v = (c | 32) - 87 \}\n        if v >= base \{ return 0 \}\n        bn_mul_small(d, base)\n        if mem_get(d) == 0 \{ bn_from(d, v) \} else \{\n          let one = bn_new(2)\n          bn_from(one, v)\n          bn_add(d, d, one)\n        \}\n        i = i + 1\n      \}\n      rt_pn_ok = 1\n      if mem_get(d) == 0 \{ return 0 \}\n      return rt_dec_to_double(d, 0)\n    \}\n  \}\n  var ndig = 0\n  var sig = 0\n  var e10 = 0\n  var seen_point = 0\n  var sticky = 0\n  let one = bn_new(2)\n  while i < n \{\n    let c = mem_get8(p + i)\n    if c == 46 \{\n      if seen_point \{ return 0 \}\n      seen_point = 1\n    \} else if c >= 48 and c <= 57 \{\n      ndig = ndig + 1\n      if sig > 0 or c != 48 \{\n        if sig < 780 \{\n          bn_mul_small(d, 10)\n          bn_from(one, c - 48)\n          bn_add(d, d, one)\n          sig = sig + 1\n          if seen_point \{ e10 = e10 - 1 \}\n        \} else \{\n          if c != 48 \{ sticky = 1 \}\n          if not seen_point \{ e10 = e10 + 1 \}\n        \}\n      \} else if seen_point \{\n        e10 = e10 - 1\n      \}\n    \} else \{\n      break\n    \}\n    i = i + 1\n  \}\n  if ndig == 0 \{ return 0 \}\n  if i < n \{\n    let c = mem_get8(p + i) | 32\n    if c != 101 \{ return 0 \}\n    i = i + 1\n    var eneg = 0\n    if i < n and (mem_get8(p + i) == 43 or mem_get8(p + i) == 45) \{\n      if mem_get8(p + i) == 45 \{ eneg = 1 \}\n      i = i + 1\n    \}\n    if i >= n \{ return 0 \}\n    var ev = 0\n    while i < n \{\n      let c2 = mem_get8(p + i)\n      if c2 < 48 or c2 > 57 \{ return 0 \}\n      if ev < 100000 \{ ev = ev * 10 + (c2 - 48) \}\n      i = i + 1\n    \}\n    if eneg \{ e10 = e10 - ev \} else \{ e10 = e10 + ev \}\n  \}\n  rt_pn_ok = 1\n  var r = 0\n  if mem_get(d) != 0 \{\n    if sticky \{\n      // more than 780 significant digits: keep 779 and a 1 (V8's rule), which rounds the same way\n      bn_mul_small(d, 10)\n      bn_from(one, 1)\n      bn_add(d, d, one)\n      e10 = e10 - 1\n    \}\n    if e10 + sig > 310 \{\n      r = F_INF\n    \} else if e10 + sig < -330 \{\n      r = 0\n    \} else \{\n      r = rt_dec_to_double(d, e10)\n    \}\n  \}\n  if neg \{ return r | rt_sign_bit() \}\n  return r\n\}\n"
