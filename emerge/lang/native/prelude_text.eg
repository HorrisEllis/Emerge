out[len(out)] = hi * 16 + lo\n    i += 2\n  \}\n  return bytes(out)\n\}\n\n// fixed-width integers to bytes: one function, nine widths. A num that is a safe integer, or an int, inside the width's range.\nfn _fixed(n, who, width, signed, big, range) \{\n  var v = 0i\n  if type_of(n) == \"int\" \{\n    v = n\n  \} else if type_of(n) == \"num\" and floor(n) == n and n >= -9007199254740991 and n <= 9007199254740991 \{\n    v = int(n)\n  \} else \{\n    raise(\"\{who\} needs an int in \{range\}, got \{repr(n)\}\")\n  \}\n  if width < 8 \{\n    var lo = 0i\n    var hi = (1i << (width * 8)) - 1i\n    if signed \{\n      lo = -(1i << (width * 8 - 1))\n      hi = (1i << (width * 8 - 1)) - 1i\n    \}\n    if v < lo or v > hi \{ raise(\"\{who\} needs an int in \{range\}, got \{repr(n)\}\") \}\n  \} else if not signed and v < 0i \{\n    raise(\"\{who\} needs an int in \{range\}, got \{repr(n)\}\")\n  \}\n  var out = []\n  for k in 0..width \{ out[k] = 0 \}\n  for k in 0..width \{\n    var at = k\n    if big \{ at = width - 1 - k \}\n    out[at] = num(shr_u(v, k * 8) & 0xFFi)\n  \}\n  return bytes(out)\n\}\n\nfn u8(n) = _fixed(n, \"u8\", 1, false, false, \"0..255\")\nfn u16le(n) = _fixed(n, \"u16le\", 2, false, false, \"0..65535\")\nfn u32le(n) = _fixed(n, \"u32le\", 4, false, false, \"0..4294967295\")\nfn u64le(n) = _fixed(n, \"u64le\", 8, false, false, \"0..18446744073709551615\")\nfn i32le(n) = _fixed(n, \"i32le\", 4, true, false, \"-2147483648..2147483647\")\nfn i64le(n) = _fixed(n, \"i64le\", 8, true, false, \"-9223372036854775808..9223372036854775807\")\nfn u16be(n) = _fixed(n, \"u16be\", 2, false, true, \"0..65535\")\nfn u32be(n) = _fixed(n, \"u32be\", 4, false, true, \"0..4294967295\")\nfn u64be(n) = _fixed(n, \"u64be\", 8, false, true, \"0..18446744073709551615\")\n\n// the inverse of u64be, for a value that fits in 63 bits (a larger one is an error, never a wrap)\nfn read_u64be(b, off) \{\n  _need_bytes(b, \"read_u64be\")\n  _need_num(off, \"read_u64be\")\n  if floor(o