// lang/native/front.eg — Emerge's front end in Emerge: source text → the same syntax tree lang/lexer.js and
// lang/parser.js produce (type, line, col and the fields the code generator reads). With it the native compiler reads
// .eg files itself, and Node is not needed to build Emerge (CIE-EG section 0, section 10.1 stage 1).
//
//   parse(text, file) → { type: "Program", items, file }
//
// The lexer works on bytes (constant-time indexing) and builds strings with utf8(). Like the code generator, this file
// avoids lambdas, pipes and try so it can be compiled natively. Constructs outside the native subset (compartments,
// components, kinds, emit, …) are refused by name at the line they start.

// ── lexer ────────────────────────────────────────────────────────────────────
let KEYWORDS = { use: 1, as: 1, fn: 1, compartment: 1, component: 1, template: 1, spawn: 1, despawn: 1, wire: 1, send: 1,
  state: 1, constraint: 1, invariant: 1, on: 1, axiom: 1, test: 1, let: 1, var: 1, if: 1, else: 1, while: 1, for: 1, in: 1,
  break: 1, skip: 1, return: 1, emit: 1, with: 1, record: 1, gap: 1, promote: 1, try: 1, expect: 1, whatif: 1, true: 1,
  false: 1, null: 1, and: 1, or: 1, not: 1, contains: 1, starts_with: 1, ends_with: 1, matches: 1 }
// longest first
let OPS = ["->", "**", "..", "|>", "??", "==", "!=", "<<", ">>", "<=", ">=", "+=", "-=", "*=", "/=", "&", "|", "^", "~",
  "(", ")", "[", "]", "\{", "\}", ",", ".", ":", ";", "=", "<", ">", "+", "-", "*", "/", "%", "?"]

var file = "<input>"
var src = bytes("")
var ops_bytes = []

fn syntax_error(msg, line, col) { raise("{file}:{line}:{col}: error: {msg}") }
fn is_digit(c) { return c >= 48 and c <= 57 }
fn is_alpha(c) { return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 }
fn is_alnum(c) { return is_alpha(c) or is_digit(c) }
fn is_hex(c) { return is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70) }
fn hex_digit(c) {
  if is_digit(c) { return c - 48 }
  if c >= 97 { return c - 87 }
  return c - 55
}
fn byte_at(i, end) {
  if i < end { return src[i] }
  return -1
}
fn text(a, b) { return utf8(slice(src, a, b)) }
fn tok(t, v, line, col) { return { t: t, v: v, line: line, col: col } }
fn escape_byte(e) {
  if e == 110 { return 10 }
  if e == 116 { return 9 }
  if e == 114 { return 13 }
  if e == 34 { return 34 }
  if e == 92 { return 92 }
  if e == 123 { return 123 }
  if e == 125 { return 125 }
  if e == 48 { return 0 }
  return -1
}
// decimal text without leading zeros (BigInt(text).toString())
fn trim_zeros(t) {
  var k = 0
  while k < len(t) - 1 and t[k] == "0" { k += 1 }
  return slice(t, k)
}
fn int_too_big(dec) {
  let m = "9223372036854775807"
  if len(dec) != len(m) { return len(dec) > len(m) }
  return dec > m
}

// tokens of src[start, end), starting at line:col
fn lex_range(start, end, line0, col0) {
  if len(ops_bytes) == 0 {
    for o in OPS { ops_bytes[len(ops_bytes)] = bytes(o) }
  }
  var toks = []
  var i = start
  var line = line0
  var col = col0
  var depth = 0
  while i < end {
    let ch = src[i]
    if ch == 10 {
      if depth == 0 and len(toks) > 0 and toks[len(toks) - 1].t != "NL" { toks[len(toks)] = tok("NL", "\n", line, col) }
      i += 1
      line += 1
      col = 1
      skip
    }
    if ch == 32 or ch == 9 or ch == 13 {
      i += 1
      col += 1
      skip
    }
    if ch == 47 and byte_at(i + 1, end) == 47 {
      while i < end and src[i] != 10 {
        i += 1
        col += 1
      }
      skip
    }
    if ch == 47 and byte_at(i + 1, end) == 42 {
      let l = line
      let c = col
      i += 2
      col += 2
      while i < end and not (src[i] == 42 and byte_at(i + 1, end) == 47) {
        if src[i] == 10 {
          line += 1
          col = 1
        } else {
          col += 1
        }
        i += 1
      }
      if i >= end { syntax_error("unterminated /* comment", l, c) }
      i += 2
      col += 2
      skip
    }
    let nx = byte_at(i + 1, end)
    if ch == 48 and (nx == 120 or nx == 88 or nx == 98 or nx == 66) {
      let l = line
      let c = col
      let s = i
      let hexa = nx == 120 or nx == 88
      i += 2
      col += 2
      while i < end and ((hexa and is_hex(src[i])) or (not hexa and (src[i] == 48 or src[i] == 49)) or src[i] == 95) {
        i += 1
        col += 1
      }
      var digits = []
      for k in s + 2..i {
        if src[k] != 95 { digits[len(digits)] = src[k] }
      }
      var base = 2
      if hexa { base = 16 }
      if len(digits) > 0 and byte_at(i, end) == 105 and not is_alnum(byte_at(i + 1, end)) {
        var v = 0i
        let lim = 9223372036854775807i
        for dg in digits {
          let dv = int(hex_digit(dg))
          if v > idiv(lim - dv, int(base)) { syntax_error("int literal {text(s, i)}i is larger than 2^63-1", l, c) }
          v = v * int(base) + dv
        }
        i += 1
        col += 1
        toks[len(toks)] = tok("INT", str(v), l, c)
        skip
      }
      if len(digits) == 0 or (i < end and is_alnum(src[i])) {
        var what = "binary"
        if hexa { what = "hex" }
        syntax_error("malformed {what} number \"{text(s, i + 1)}\"", l, c)
      }
      var nv = 0
      for dg in digits {
        nv = nv * base + hex_digit(dg)
        if nv > 9007199254740991 { syntax_error("number {text(s, i)} is larger than 2^53 and cannot be exact", l, c) }
      }
      toks[len(toks)] = tok("NUM", nv, l, c)
      skip
    }
    if is_digit(ch) {
      let l = line
      let c = col
      let s = i
      while i < end and (is_digit(src[i]) or src[i] == 95) {
        i += 1
        col += 1
      }
      var plain_int = true
      if byte_at(i, end) == 46 and is_digit(byte_at(i + 1, end)) {
        plain_int = false
        i += 1
        col += 1
        while i < end and (is_digit(src[i]) or src[i] == 95) {
          i += 1
          col += 1
        }
      }
      let ex = byte_at(i, end)
      let ex2 = byte_at(i + 1, end)
      if (ex == 101 or ex == 69) and (is_digit(ex2) or ex2 == 43 or ex2 == 45) {
        plain_int = false
        i += 1
        col += 1
        if src[i] == 43 or src[i] == 45 {
          i += 1
          col += 1
        }
        if not is_digit(byte_at(i, end)) { syntax_error("malformed exponent", line, col) }
        while i < end and is_digit(src[i]) {
          i += 1
          col += 1
        }
      }
      var nb = []
      for k in s..i {
        if src[k] != 95 { nb[len(nb)] = src[k] }
      }
      let t = utf8(bytes(nb))
      if byte_at(i, end) == 105 and plain_int and not is_alnum(byte_at(i + 1, end)) {
        let dec = trim_zeros(t)
        if int_too_big(dec) { syntax_error("int literal {t}i is larger than 2^63-1", l, c) }
        i += 1
        col += 1
        toks[len(toks)] = tok("INT", dec, l, c)
        skip
      }
      if is_alpha(byte_at(i, end)) { syntax_error("malformed number \"{text(s, i + 1)}\"", l, c) }
      toks[len(toks)] = tok("NUM", num(t), l, c)
      skip
    }
    if is_alpha(ch) {
      let l = line
      let c = col
      let s = i
      while i < end and is_alnum(src[i]) {
        i += 1
        col += 1
      }
      let w = text(s, i)
      if has(KEYWORDS, w) { toks[len(toks)] = tok("KW", w, l, c) } else { toks[len(toks)] = tok("IDENT", w, l, c) }
      skip
    }
    if ch == 34 {
      let l = line
      let c = col
      i += 1
      col += 1
      var parts = []
      var buf = []
      while true {
        if i >= end or src[i] == 10 { syntax_error("unterminated string", l, c) }
        let dch = src[i]
        if dch == 34 {
          i += 1
          col += 1
          break
        }
        if dch == 92 {
          let eb = escape_byte(byte_at(i + 1, end))
          if eb < 0 { syntax_error("unknown escape \\{text(i + 1, i + 2)}", line, col) }
          buf[len(buf)] = eb
          i += 2
          col += 2
          skip
        }
        if dch == 123 {
          if len(buf) > 0 {
            parts[len(parts)] = utf8(bytes(buf))
            buf = []
          }
          let el = line
          let ec = col + 1
          i += 1
          col += 1
          let s = i
          var lvl = 1
          while i < end and lvl > 0 {
            let xb = src[i]
            if xb == 10 { syntax_error("unterminated interpolation", el, ec - 1) }
            if xb == 34 {
              i += 1
              col += 1
              while i < end and src[i] != 34 {
                if src[i] == 92 {
                  i += 1
                  col += 1
                }
                if byte_at(i, end) == 10 { syntax_error("unterminated string", el, ec) }
                i += 1
                col += 1
              }
              i += 1
              col += 1
              skip
            }
            if xb == 123 { lvl += 1 } else if xb == 125 {
              lvl -= 1
              if lvl == 0 { break }
            }
            i += 1
            col += 1
          }
          if lvl != 0 { syntax_error("unterminated interpolation", el, ec - 1) }
          var blank = true
          for k in s..i {
            let b = src[k]
            if b != 32 and b != 9 and b != 13 and b != 10 { blank = false }
          }
          if blank { syntax_error("empty interpolation \{\} — write \\\{ for a literal brace", el, ec - 1) }
          let sub = lex_range(s, i, el, ec)
          var inner = []
          for st in sub {
            if st.t != "NL" { inner[len(inner)] = st }
          }
          parts[len(parts)] = inner
          i += 1
          col += 1
          skip
        }
        if dch == 125 { syntax_error("unmatched \} in string — write \\\} for a literal brace", line, col) }
        buf[len(buf)] = dch
        i += 1
        col += 1
      }
      if len(buf) > 0 or len(parts) == 0 { parts[len(parts)] = utf8(bytes(buf)) }
      var plain = true
      var joined = ""
      for p in parts {
        if type_of(p) == "string" { joined = joined + p } else { plain = false }
      }
      var st = tok("STR", null, l, c)
      if plain { st.v = joined }
      st.parts = parts
      toks[len(toks)] = st
      skip
    }
    var found = -1
    var oi = 0
    while oi < len(ops_bytes) and found < 0 {
      let ob = ops_bytes[oi]
      var ok = i + len(ob) <= end
      var k = 0
      while ok and k < len(ob) {
        if src[i + k] != ob[k] { ok = false }
        k += 1
      }
      if ok { found = oi }
      oi += 1
    }
    if found >= 0 {
      let op = OPS[found]
      if op == "(" or op == "[" { depth += 1 }
      if op == ")" or op == "]" { depth = max(0, depth - 1) }
      toks[len(toks)] = tok("OP", op, line, col)
      i += len(ops_bytes[found])
      col += len(ops_bytes[found])
      skip
    }
    syntax_error("unexpected character \"{text(i, i + 1)}\"", line, col)
  }
  if len(toks) > 0 and toks[len(toks) - 1].t != "NL" { toks[len(toks)] = tok("NL", "\n", line, col) }
  toks[len(toks)] = tok("EOF", null, line, col)
  return toks
}
fn lex(text_src, name) {
  file = name
  src = bytes(text_src)
  return lex_range(0, len(src), 1, 1)
}

// ── parser ───────────────────────────────────────────────────────────────────
let TYPES = { int: 1, float: 1, num: 1, string: 1, bool: 1, list: 1, map: 1, bytes: 1, fn: 1, any: 1 }
let ASSIGN_OPS = { "=": 1, "+=": 1, "-=": 1, "*=": 1, "/=": 1 }
let COMPARE_OPS = { "==": 1, "!=": 1, "<": 1, "<=": 1, ">": 1, ">=": 1 }
let COMPARE_KWS = { contains: 1, starts_with: 1, ends_with: 1, matches: 1, in: 1 }

var toks = []
var at = 0

fn describe(t) {
  if t.t == "EOF" { return "end of file" }
  if t.t == "NL" { return "end of line" }
  if t.t == "STR" { return "a string" }
  if t.t == "NUM" { return "number {t.v}" }
  if t.t == "INT" { return "int {t.v}i" }
  return "\"{t.v}\""
}
fn peek(o) {
  var k = at + o
  if k > len(toks) - 1 { k = len(toks) - 1 }
  return toks[k]
}
fn next() {
  let t = toks[at]
  if at < len(toks) - 1 { at += 1 }
  return t
}
fn is_tok(t, v) {
  let k = peek(0)
  return k.t == t and (v == null or k.v == v)
}
fn is_op(v) { return is_tok("OP", v) }
fn is_kw(v) { return is_tok("KW", v) }
fn is_word(v) { return is_tok("IDENT", v) }
fn perr(msg, t) { syntax_error(msg, t.line, t.col) }
fn want_op(v, what) {
  if not is_op(v) {
    var w = ""
    if what != "" { w = " " + what }
    perr("expected \"{v}\"{w}, found {describe(peek(0))}", peek(0))
  }
  return next()
}
fn want_kw(v, what) {
  if not is_kw(v) { perr("expected \"{v}\" {what}, found {describe(peek(0))}", peek(0)) }
  return next()
}
fn want_ident(what) {
  if not is_tok("IDENT", null) { perr("expected {what}, found {describe(peek(0))}", peek(0)) }
  return next()
}
fn skip_nl() {
  while is_tok("NL", null) or is_op(";") { next() }
}
fn node(type, t, fields) {
  var m = { type: type, line: t.line, col: t.col }
  for k, v in fields { m[k] = v }
  return m
}
fn end_stmt() {
  if is_tok("NL", null) or is_op(";") {
    skip_nl()
    return null
  }
  if is_op("\}") or is_tok("EOF", null) { return null }
  perr("expected end of statement, found {describe(peek(0))}", peek(0))
}
fn peek_else() {
  var k = 0
  while peek(k).t == "NL" { k += 1 }
  if peek(k).t == "KW" and peek(k).v == "else" {
    at += k
    return true
  }
  return false
}

fn parse(text_src, name) {
  toks = lex(text_src, name)
  at = 0
  let start = peek(0)
  var items = []
  skip_nl()
  while not is_tok("EOF", null) {
    items[len(items)] = parse_item()
    end_stmt()
  }
  return node("Program", start, { items: items, file: name })
}
fn refuse_at(what, t) { perr("{what} is not in the native subset yet", t) }
fn parse_item() {
  let t = peek(0)
  if t.t == "IDENT" and t.v == "kind" and peek(1).t == "IDENT" and ((peek(2).t == "OP" and peek(2).v == "\{") or (peek(2).t == "IDENT" and peek(2).v == "is")) {
    refuse_at("kind", t)
  }
  if t.t == "KW" {
    if t.v == "use" { return parse_use() }
    if t.v == "compartment" or t.v == "component" or t.v == "template" or t.v == "axiom" or t.v == "test" or t.v == "on" {
      refuse_at(t.v, t)
    }
  }
  return parse_stmt(true)
}
fn parse_use() {
  let t = next()
  if not is_tok("STR", null) or peek(0).v == null { perr("expected a plain string path after use", peek(0)) }
  let p = next().v
  want_kw("as", "after the module path")
  let alias = want_ident("a module name after as").v
  return node("Use", t, { path: p, alias: alias })
}
fn parse_type() {
  let t = peek(0)
  var name = ""
  if t.t == "IDENT" and has(TYPES, t.v) { name = next().v } else if t.t == "KW" and t.v == "fn" { name = next().v } else {
    perr("expected a type (int, float, num, string, bool, list, map, bytes, fn, any), found {describe(t)}", t)
  }
  var nullable = false
  if is_op("?") {
    next()
    nullable = true
  }
  return { name: name, nullable: nullable }
}
fn parse_params() {
  want_op("(", "to open the parameter list")
  var params = []
  var seen = {}
  while not is_op(")") {
    let p = want_ident("a parameter name")
    if has(seen, p.v) { perr("parameter \"{p.v}\" is declared twice", p) }
    seen[p.v] = 1
    var ty = null
    if is_op(":") {
      next()
      ty = parse_type()
    }
    params[len(params)] = { name: p.v, type: ty, line: p.line, col: p.col }
    if is_op(",") { next() } else { break }
  }
  want_op(")", "to close the parameter list")
  return params
}
fn parse_fn_rest(name) {
  let params = parse_params()
  var ret = null
  if is_op(":") {
    next()
    ret = parse_type()
  }
  var body = null
  if is_op("=") {
    let eq = next()
    skip_nl()
    let ex = parse_expr()
    body = node("Block", eq, { body: [node("Return", eq, { expr: ex })] })
  } else {
    body = parse_block()
  }
  return { name: name, params: params, ret: ret, body: body }
}
fn parse_fn_decl() {
  let t = next()
  let name = want_ident("a function name").v
  return node("FnDecl", t, parse_fn_rest(name))
}
fn parse_block() {
  let t = want_op("\{", "to open a block")
  var body = []
  skip_nl()
  while not is_op("\}") {
    if is_tok("EOF", null) { perr("unterminated block — missing \"\}\"", t) }
    body[len(body)] = parse_stmt(false)
    end_stmt()
  }
  next()
  return node("Block", t, { body: body })
}
fn parse_stmt(top) {
  let t = peek(0)
  if t.t == "KW" {
    let k = t.v
    if k == "let" or k == "var" {
      next()
      let name = want_ident("a variable name after {k}").v
      var vtype = null
      if is_op(":") {
        next()
        vtype = parse_type()
      }
      want_op("=", "— {k} needs a value")
      skip_nl()
      return node("Let", t, { kind: k, name: name, vtype: vtype, expr: parse_expr() })
    }
    if k == "fn" and peek(1).t == "IDENT" { return parse_fn_decl() }
    if k == "if" { return parse_if() }
    if k == "while" {
      next()
      let c = parse_expr()
      return node("While", t, { cond: c, body: parse_block() })
    }
    if k == "for" {
      next()
      if is_word("each") { next() }
      let a = want_ident("a loop variable").v
      var b = null
      if is_op(",") {
        next()
        b = want_ident("a second loop variable").v
      }
      want_kw("in", "in a for loop")
      let iter = parse_expr()
      return node("For", t, { a: a, b: b, iter: iter, body: parse_block() })
    }
    if k == "break" {
      next()
      return node("Break", t, {})
    }
    if k == "skip" {
      next()
      return node("Skip", t, {})
    }
    if k == "return" {
      next()
      let ends = is_tok("NL", null) or is_op(";") or is_op("\}") or is_tok("EOF", null)
      var ex = null
      if not ends { ex = parse_expr() }
      return node("Return", t, { expr: ex })
    }
    if k == "try" {
      next()
      let body = parse_block()
      if not peek_else() { perr("NO_SILENT_DROP: try needs an else block that handles the failure", peek(0)) }
      next()
      var err_name = null
      if is_tok("IDENT", null) { err_name = next().v }
      let handler = parse_block()
      return node("Try", t, { body: body, errName: err_name, handler: handler })
    }
    if k == "wire" or k == "despawn" or k == "send" or k == "emit" or k == "record" or k == "gap" or k == "promote" or k == "expect" {
      refuse_at(k, t)
    }
    if k == "use" or k == "compartment" or k == "component" or k == "template" or k == "axiom" or k == "test" or k == "on" {
      if not top { perr("{k} is only allowed at the top level of a file", t) }
    }
  }
  let ex = parse_expr()
  if is_tok("OP", null) and has(ASSIGN_OPS, peek(0).v) {
    let op = next()
    if ex.type != "Ident" and ex.type != "Member" and ex.type != "Index" { perr("this cannot be assigned to", op) }
    skip_nl()
    return node("Assign", op, { target: ex, op: op.v, expr: parse_expr() })
  }
  return node("ExprStmt", t, { expr: ex })
}
fn parse_if() {
  let t = next()
  let c = parse_expr()
  let th = parse_block()
  var otherwise = null
  if peek_else() {
    next()
    if is_kw("if") { otherwise = parse_if() } else { otherwise = parse_block() }
  }
  return node("If", t, { cond: c, then: th, otherwise: otherwise })
}

// ── expressions ──────────────────────────────────────────────────────────────
fn parse_expr() { return parse_pipe() }
fn parse_pipe() {
  var l = parse_coalesce()
  while true {
    var k = 0
    while peek(k).t == "NL" { k += 1 }
    if not (peek(k).t == "OP" and peek(k).v == "|>") { break }
    at += k
    let op = next()
    skip_nl()
    let r = parse_coalesce()
    if r.type == "Call" {
      var args = [l]
      for a in r.args { args[len(args)] = a }
      l = node("Call", op, { callee: r.callee, args: args, pipe: true })
    } else {
      l = node("Call", op, { callee: r, args: [l], pipe: true })
    }
  }
  return l
}
// one left-associative level: level names the next level down
fn level_has(ops) {
  let k = peek(0)
  return (k.t == "OP" or k.t == "KW") and has(ops, k.v)
}
fn parse_coalesce() {
  var l = parse_or()
  while is_op("??") {
    let op = next()
    skip_nl()
    l = node("Coalesce", op, { op: op.v, l: l, r: parse_or() })
  }
  return l
}
fn parse_or() {
  var l = parse_and()
  while is_kw("or") {
    let op = next()
    skip_nl()
    l = node("Logical", op, { op: op.v, l: l, r: parse_and() })
  }
  return l
}
fn parse_and() {
  var l = parse_not()
  while is_kw("and") {
    let op = next()
    skip_nl()
    l = node("Logical", op, { op: op.v, l: l, r: parse_not() })
  }
  return l
}
fn parse_not() {
  if is_kw("not") {
    let t = next()
    return node("Unary", t, { op: "not", expr: parse_not() })
  }
  return parse_compare()
}
fn is_compare(k) { return (k.t == "OP" and has(COMPARE_OPS, k.v)) or (k.t == "KW" and has(COMPARE_KWS, k.v)) }
fn parse_compare() {
  let l = parse_range()
  if is_compare(peek(0)) {
    let op = next()
    skip_nl()
    let r = parse_range()
    if is_compare(peek(0)) { perr("comparisons do not chain — write a < b and b < c", peek(0)) }
    return node("Binary", op, { op: op.v, l: l, r: r })
  }
  return l
}
fn parse_range() {
  let l = parse_bitor()
  if is_op("..") {
    let op = next()
    return node("Binary", op, { op: "..", l: l, r: parse_bitor() })
  }
  return l
}
fn binary_left(level, ops) {
  var l = parse_level(level)
  while level_has(ops) {
    let op = next()
    skip_nl()
    l = node("Binary", op, { op: op.v, l: l, r: parse_level(level) })
  }
  return l
}
// levels below .. : 1 bit-or · 2 bit-xor · 3 bit-and · 4 shift · 5 add · 6 mul · 7 unary
fn parse_level(level) {
  if level == 1 { return binary_left(2, { "|": 1 }) }
  if level == 2 { return binary_left(3, { "^": 1 }) }
  if level == 3 { return binary_left(4, { "&": 1 }) }
  if level == 4 { return binary_left(5, { "<<": 1, ">>": 1 }) }
  if level == 5 { return binary_left(6, { "+": 1, "-": 1 }) }
  if level == 6 { return binary_left(7, { "*": 1, "/": 1, "%": 1 }) }
  return parse_unary()
}
fn parse_bitor() { return parse_level(1) }
fn parse_unary() {
  if is_op("-") or is_op("~") {
    let t = next()
    return node("Unary", t, { op: t.v, expr: parse_unary() })
  }
  return parse_pow()
}
fn parse_pow() {
  let l = parse_postfix()
  if is_op("**") {
    let op = next()
    skip_nl()
    return node("Binary", op, { op: "**", l: l, r: parse_unary() })
  }
  return l
}
fn parse_postfix() {
  var ex = parse_primary()
  while true {
    if is_op("(") {
      let t = next()
      var args = []
      while not is_op(")") {
        args[len(args)] = parse_expr()
        if is_op(",") { next() } else { break }
      }
      want_op(")", "to close the call")
      ex = node("Call", t, { callee: ex, args: args })
    } else if is_op(".") {
      let t = next()
      let k = peek(0)
      if k.t != "IDENT" and k.t != "KW" { perr("expected a member name after \".\", found {describe(k)}", k) }
      next()
      ex = node("Member", t, { obj: ex, name: k.v })
    } else if is_op("[") {
      let t = next()
      let index = parse_expr()
      want_op("]", "to close the index")
      ex = node("Index", t, { obj: ex, index: index })
    } else {
      break
    }
  }
  return ex
}
// the expression inside one {interpolation}, from its own token list
fn parse_sub(sub) {
  let saved_toks = toks
  let saved_at = at
  var list = sub
  if len(list) == 0 or list[len(list) - 1].t != "EOF" {
    list = []
    for st in sub { list[len(list)] = st }
    var last_line = 0
    var last_col = 0
    if len(sub) > 0 {
      last_line = sub[len(sub) - 1].line
      last_col = sub[len(sub) - 1].col
    }
    list[len(list)] = tok("EOF", null, last_line, last_col)
  }
  toks = list
  at = 0
  let ex = parse_expr()
  if not is_tok("EOF", null) { perr("unexpected {describe(peek(0))} in interpolation", peek(0)) }
  toks = saved_toks
  at = saved_at
  return ex
}
fn parse_primary() {
  let t = peek(0)
  if t.t == "NUM" {
    next()
    return node("Num", t, { value: t.v })
  }
  if t.t == "INT" {
    next()
    return node("Int", t, { value: { bigint: t.v } })
  }
  if t.t == "STR" {
    next()
    var parts = []
    for p in t.parts {
      if type_of(p) == "string" { parts[len(parts)] = p } else { parts[len(parts)] = parse_sub(p) }
    }
    return node("Str", t, { parts: parts })
  }
  if t.t == "IDENT" {
    next()
    return node("Ident", t, { name: t.v })
  }
  if t.t == "KW" {
    if t.v == "true" or t.v == "false" {
      next()
      return node("Bool", t, { value: t.v == "true" })
    }
    if t.v == "null" {
      next()
      return node("Null", t, {})
    }
    if t.v == "fn" {
      next()
      return node("Lambda", t, parse_fn_rest(null))
    }
    if t.v == "state" or t.v == "whatif" or t.v == "spawn" { refuse_at(t.v, t) }
  }
  if t.t == "OP" {
    if t.v == "(" {
      next()
      let ex = parse_expr()
      want_op(")", "to close the parenthesis")
      return ex
    }
    if t.v == "[" {
      next()
      var items = []
      while not is_op("]") {
        items[len(items)] = parse_expr()
        if is_op(",") { next() } else { break }
      }
      want_op("]", "to close the list")
      return node("List", t, { items: items })
    }
    if t.v == "\{" {
      next()
      skip_nl()
      var entries = []
      var seen = {}
      while not is_op("\}") {
        let k = peek(0)
        var key = ""
        if k.t == "IDENT" or k.t == "KW" { key = k.v } else if k.t == "STR" and k.v != null { key = k.v } else {
          perr("expected a map key, found {describe(k)}", k)
        }
        if has(seen, key) { perr("map key \"{key}\" appears twice", k) }
        seen[key] = 1
        next()
        want_op(":", "after the map key")
        skip_nl()
        entries[len(entries)] = { key: key, value: parse_expr() }
        skip_nl()
        if is_op(",") {
          next()
          skip_nl()
        } else {
          break
        }
      }
      skip_nl()
      want_op("\}", "to close the map")
      return node("Map", t, { entries: entries })
    }
  }
  perr("expected an expression, found {describe(t)}", t)
}
