// lang/native/embed.eg — writes a source file as one Emerge string, so the native compiler carries its runtime and the
// prelude inside itself (one executable, CIE-EG section 0). Run after changing rt.eg or core/prelude.eg:
//   eg run embed.eg rt.eg rt_text.eg
//   eg run embed.eg ../core/prelude.eg prelude_text.eg
fn escaped(b) {
  if b == 10 { return [92, 110] }
  if b == 9 { return [92, 116] }
  if b == 13 { return [92, 114] }
  if b == 34 { return [92, 34] }
  if b == 92 { return [92, 92] }
  if b == 123 { return [92, 123] }
  if b == 125 { return [92, 125] }
  if b == 0 { return [92, 48] }
  return [b]
}
fn base(p) {
  var i = len(p) - 1
  while i >= 0 and p[i] != "/" { i -= 1 }
  return slice(p, i + 1)
}
fn embed(src_path, out_path) {
  let src = read_bytes(src_path)
  let note = "// GENERATED by embed.eg from {base(src_path)} — do not edit; regenerate as the top of embed.eg says\n"
  var out = [bytes(note + "let TEXT = \"")]
  for b in src { out[len(out)] = escaped(b) }
  out[len(out)] = bytes("\"\n")
  write_bytes(out_path, bytes(out))
}
let a = args()
embed(a[0], a[1])
